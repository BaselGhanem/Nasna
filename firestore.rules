    function validWorkflowEventCreate(
      companyId,
      workflowRequestId,
      eventId
    ) {
      let event = request.resource.data;
      let requestAfter = getAfter(
        workflowRequestPath(companyId, workflowRequestId)
      ).data;
      return activeMember(companyId)
        && (
          requestAfter.updatedBy == request.auth.uid
          || (
            event.type == 'COMMENTED'
            && canReadWorkflowRequest(companyId, requestAfter)
          )
        )
        && event.id == eventId
        && event.companyId == companyId
        && event.requestId == workflowRequestId
        && event.actorUid == request.auth.uid
        && event.actorName is string
        && event.actorName.size() <= 140
        && event.actorRole is string
        && event.type in [
          'CREATED',
          'DRAFT_SAVED',
          'SUBMITTED',
          'APPROVED',
          'REJECTED',
          'INFORMATION_REQUESTED',
          'INFORMATION_PROVIDED',
          'FULFILLED',
          'WITHDRAWN',
          'CANCELLED',
          'COMMENTED',
          'DELEGATED'
        ]
        && event.message is string
        && event.message.size() <= 1000
        && event.payload is map
        && event.createdAt == request.time
        && event.keys().hasOnly([
          'id',
          'companyId',
          'requestId',
          'actorUid',
          'actorName',
          'actorRole',
          'type',
          'message',
          'payload',
          'createdAt'
        ]);
    }

    function validUserShape(uid) {
