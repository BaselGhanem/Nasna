          );

        allow create: if validRequestFulfilledShiftAssignment(
              companyId,
              assignmentId
            )
          || (
            canScheduleEmployee(
              companyId,
              request.resource.data.employeeId
            )
            && validShiftAssignmentShape(companyId, assignmentId)
            && request.resource.data.status == 'draft'
            && request.resource.data.version == 0
            && request.resource.data.previousAssignmentId == ''
            && request.resource.data.supersededBy == ''
            && request.resource.data.sourceRequestId == ''
            && request.resource.data.conflictCheck.result == 'pending'
            && request.resource.data.publishedAt == null
            && request.resource.data.publishedBy == ''
            && existsAfter(
