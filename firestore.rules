      match /employees/{employeeId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validEmployeeShape(companyId, employeeId)
          && activeEmployeeRelations(companyId, employeeId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && memberAfter(companyId, request.resource.data.authUid).data.employeeId == employeeId
          && memberAfter(companyId, request.resource.data.authUid).data.email == request.resource.data.workEmail
          && memberAfter(companyId, request.resource.data.authUid).data.status == request.resource.data.accessStatus
          && getAfter(userPath(request.resource.data.authUid)).data.employeeId == employeeId
          && getAfter(userPath(request.resource.data.authUid)).data.activeCompanyId == companyId
          && getAfter(userPath(request.resource.data.authUid)).data.email == request.resource.data.workEmail
          && getAfter(userPath(request.resource.data.authUid)).data.status == request.resource.data.accessStatus;

        allow update: if admin(companyId)
          && validEmployeeUpdateValues(employeeId)
          && activeEmployeeRelations(companyId, employeeId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.employeeCode == resource.data.employeeCode
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.workEmail == resource.data.workEmail
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && employeeAssignmentChangeBacked(companyId, employeeId)
          && memberAfter(companyId, request.resource.data.authUid).data.employeeId == employeeId
          && memberAfter(companyId, request.resource.data.authUid).data.status == request.resource.data.accessStatus
          && getAfter(userPath(request.resource.data.authUid)).data.employeeId == employeeId
          && getAfter(userPath(request.resource.data.authUid)).data.status == request.resource.data.accessStatus
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accessStatus',
            'fullNameEn',
            'fullNameAr',
            'workPhone',
            'positionId',
            'jobTitleId',
            'branchId',
            'locationId',
            'departmentId',
            'teamId',
            'managerEmployeeId',
            'hireDate',
            'employmentType',
            'employmentStatus',
            'workMode',
            'lastMovementId',
            'lastRequestId',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /employeePrivate/{employeeId} {
        allow get: if admin(companyId)
          || (
            activeMember(companyId)
            && resource.data.authUid == request.auth.uid
          );

        allow list: if admin(companyId);

        allow create: if admin(companyId)
          && validEmployeePrivateShape(companyId, employeeId)
          && getAfter(employeePath(companyId, employeeId)).data.authUid == request.resource.data.authUid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validEmployeePrivateShape(companyId, employeeId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nationalId',
            'dateOfBirth',
            'gender',
            'maritalStatus',
            'nationality',
            'personalEmail',
            'personalPhone',
            'address',
            'emergencyContactName',
            'emergencyContactPhone',
            'hrNotes',
            'lastRequestId',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /employeeDocuments/{documentId} {
        allow read: if admin(companyId)
          || (
            activeMember(companyId)
            && resource.data.employeeAuthUid == request.auth.uid
            && resource.data.visibility == 'employee'
          );

        allow create: if admin(companyId)
          && validEmployeeDocumentShape(companyId, documentId)
          && exists(employeePath(companyId, request.resource.data.employeeId))
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.authUid == request.resource.data.employeeAuthUid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validEmployeeDocumentShape(companyId, documentId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.employeeAuthUid == resource.data.employeeAuthUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type',
            'title',
            'documentNumber',
            'issueDate',
            'expiryDate',
            'linkUrl',
            'visibility',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /employeeMovements/{movementId} {
        allow read: if admin(companyId)
          || (
            activeMember(companyId)
            && resource.data.employeeAuthUid == request.auth.uid
          );

        allow create: if admin(companyId)
          && validEmployeeMovementShape(companyId, movementId)
          && request.resource.data.effectiveDate <= request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && exists(employeePath(companyId, request.resource.data.employeeId))
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.authUid == request.resource.data.employeeAuthUid
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.positionId == request.resource.data.previousPositionId
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.managerEmployeeId == request.resource.data.previousManagerEmployeeId
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.employmentType == request.resource.data.previousEmploymentType
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.employmentStatus == request.resource.data.previousEmploymentStatus
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.workMode == request.resource.data.previousWorkMode
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.lastMovementId == movementId
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.positionId == request.resource.data.newPositionId
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.managerEmployeeId == request.resource.data.newManagerEmployeeId
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.employmentType == request.resource.data.newEmploymentType
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.employmentStatus == request.resource.data.newEmploymentStatus
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.workMode == request.resource.data.newWorkMode;

        allow update, delete: if false;
      }

      match /requestTypes/{requestTypeId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validRequestTypeShape(companyId, requestTypeId)
          && request.resource.data.status == 'published'
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && existsAfter(
            workflowPath(companyId, request.resource.data.workflowId)
          )
          && getAfter(
            workflowPath(companyId, request.resource.data.workflowId)
          ).data.requestTypeCode == request.resource.data.code
          && getAfter(
            workflowPath(companyId, request.resource.data.workflowId)
          ).data.version == request.resource.data.version
          && getAfter(
            workflowPath(companyId, request.resource.data.workflowId)
          ).data.steps[0].resolver
            == request.resource.data.initialResolver;

        allow update: if admin(companyId)
          && validRequestTypeShape(companyId, requestTypeId)
          && resource.data.status == 'published'
          && request.resource.data.status == 'retired'
          && request.resource.data.retiredAt == request.time
          && request.resource.data.retiredBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'retiredAt',
            'retiredBy'
          ]);

        allow delete: if false;
      }

      match /workflowDefinitions/{workflowId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validWorkflowShape(companyId, workflowId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if false;
      }

      match /workflowDrafts/{draftId} {
        allow read: if admin(companyId);

        allow create: if admin(companyId)
          && validWorkflowDraftShape(companyId, draftId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validWorkflowDraftShape(companyId, draftId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;

        allow delete: if admin(companyId);
      }

      match /requestCounters/{counterId} {
        allow read: if activeMember(companyId);

        allow create: if activeMember(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.value is int
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && (
            (
              counterId == 'requests'
              && request.resource.data.value == 1
              && requestCounterBackedByCreate(companyId)
            )
            || (
              admin(companyId)
              && counterId.matches(
                '^workflow_[A-Za-z0-9_-]{1,80}$'
              )
              && request.resource.data.value >= 1
              && request.resource.data.value <= 10000
              && request.resource.data.keys().hasOnly([
                'companyId',
                'value',
                'updatedAt',
                'updatedBy'
              ])
            )
          );

        allow update: if activeMember(companyId)
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.value is int
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && (
            (
              counterId == 'requests'
              && request.resource.data.value == resource.data.value + 1
              && (
                !resource.data.keys().hasAny(['lastRequestId'])
                || request.resource.data.lastRequestId
                  != resource.data.lastRequestId
              )
              && request.resource.data.diff(
                resource.data
              ).affectedKeys().hasOnly([
                'value',
                'lastRequestId',
                'lastRequestNumber',
                'updatedAt',
                'updatedBy'
              ])
              && requestCounterBackedByCreate(companyId)
            )
            || (
              admin(companyId)
              && counterId.matches(
                '^workflow_[A-Za-z0-9_-]{1,80}$'
              )
              && request.resource.data.value > resource.data.value
              && request.resource.data.value <= 10000
              && request.resource.data.diff(
                resource.data
              ).affectedKeys().hasOnly([
                'value',
                'updatedAt',
                'updatedBy'
              ])
            )
          );

        allow delete: if false;
      }

      match /requests/{workflowRequestId} {
        allow get: if canReadWorkflowRequest(companyId, resource.data);
        allow list: if activeMember(companyId)
          && (
            admin(companyId)
            || resource.data.requesterUid == request.auth.uid
            || resource.data.currentAssigneeIds.hasAny([request.auth.uid])
            || (
              resource.data.confidentiality == 'normal'
              && member(companyId).data.employeeId
                == resource.data.managerEmployeeId
            )
          );

        allow create: if validWorkflowRequestCreate(
          companyId,
          workflowRequestId
        );

        allow update: if validWorkflowRequestUpdate(
            companyId,
            workflowRequestId
          )
          && (
            (
              requestOwner(resource.data)
              && resource.data.status == 'DRAFT'
              && request.resource.data.status == 'DRAFT'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'payload',
                'priority',
                'updatedAt',
                'updatedBy',
                'revision',
                'lastEventId'
              ])
            )
            || (
              requestOwner(resource.data)
              && resource.data.status == 'DRAFT'
              && validInitialRequestRoute(companyId)
              && request.resource.data.currentStep == 0
              && request.resource.data.currentStepType in [
                'approval',
                'fulfillment'
              ]
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'currentStepType',
                'currentAssigneeIds',
                'delegationId',
                'originalAssigneeIds',
                'routeKind',
                'dueAt',
                'submittedAt',
                'updatedAt',
                'updatedBy',
                'revision',
                'lastEventId'
              ])
            )
            || (
              requestOwner(resource.data)
              && resource.data.status in [
                'SUBMITTED',
                'PENDING_APPROVAL',
                'NEEDS_INFORMATION',
                'PENDING_FULFILLMENT',
                'APPROVED'
              ]
              && request.resource.data.status == 'WITHDRAWN'
              && request.resource.data.currentAssigneeIds.size() == 0
              && request.resource.data.withdrawnAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'currentAssigneeIds',
                'outcome',
                'withdrawnAt',
                'updatedAt',
                'updatedBy',
                'revision',
                'lastEventId'
              ])
            )
            || (
              requestOwner(resource.data)
              && resource.data.status == 'NEEDS_INFORMATION'
              && request.resource.data.status == resource.data.previousStatus
              && request.resource.data.currentAssigneeIds
                == resource.data.previousAssigneeIds
              && request.resource.data.previousStatus == ''
              && request.resource.data.previousAssigneeIds.size() == 0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'previousStatus',
                'currentAssigneeIds',
                'previousAssigneeIds',
                'payload',
                'dueAt',
                'slaRemainingHours',
                'updatedAt',
                'updatedBy',
                'revision',
                'lastEventId'
              ])
            )
            || (
              requestAssigned(resource.data)
              && managerActor(companyId)
              && resource.data.status == 'PENDING_APPROVAL'
              && request.resource.data.status == resource.data.status
              && request.resource.data.delegationId != ''
              && request.resource.data.originalAssigneeIds
                == resource.data.currentAssigneeIds
              && request.resource.data.currentAssigneeIds.size() == 1
              && !request.resource.data.currentAssigneeIds.hasAny([
                request.auth.uid,
                resource.data.requesterUid
              ])
              && activeDelegationAfterFor(
                companyId,
                request.resource.data.delegationId,
                request.auth.uid,
                request.resource.data.currentAssigneeIds[0]
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'currentAssigneeIds',
                'delegationId',
                'originalAssigneeIds',
                'dueAt',
                'updatedAt',
                'updatedBy',
                'revision',
                'lastEventId'
              ])
            )
            || (
              managerActor(companyId)
              && resource.data.status == 'PENDING_APPROVAL'
              && resource.data.delegationId != ''
              && request.resource.data.status == resource.data.status
              && request.resource.data.delegationId == ''
              && request.resource.data.currentAssigneeIds
                == resource.data.originalAssigneeIds
              && request.resource.data.originalAssigneeIds.size() == 0
              && existsAfter(
                delegationPath(companyId, resource.data.delegationId)
              )
              && getAfter(
                delegationPath(companyId, resource.data.delegationId)
              ).data.delegatorUid == request.auth.uid
              && getAfter(
                delegationPath(companyId, resource.data.delegationId)
              ).data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'currentAssigneeIds',
                'delegationId',
                'originalAssigneeIds',
                'dueAt',
                'updatedAt',
                'updatedBy',
                'revision',
                'lastEventId'
              ])
            )
            || (
              requestAssigned(resource.data)
              && resource.data.requesterUid != request.auth.uid
              && (
                (
                  request.resource.data.status == 'NEEDS_INFORMATION'
                  && request.resource.data.previousStatus
                    == resource.data.status
                  && request.resource.data.previousAssigneeIds
                    == resource.data.currentAssigneeIds
                  && request.resource.data.currentAssigneeIds.size() == 0
                )
                || (
                  request.resource.data.status in ['REJECTED', 'CANCELLED']
                  && request.resource.data.currentAssigneeIds.size() == 0
                  && request.resource.data.completedAt == request.time
                )
                || (
                  managerActor(companyId)
                  && resource.data.status == 'PENDING_APPROVAL'
                  && request.resource.data.status == 'PENDING_FULFILLMENT'
                  && request.resource.data.routeKind == 'hr'
                  && request.resource.data.currentStep
                    == resource.data.currentStep + 1
                  && request.resource.data.currentStepType == 'fulfillment'
                  && request.resource.data.currentAssigneeIds.size() > 0
                  && get(
                    memberPath(
                      companyId,
                      request.resource.data.currentAssigneeIds[0]
                    )
                  ).data.role in ['super_admin', 'hr_admin']
                )
                || (
                  admin(companyId)
                  && request.resource.data.status in [
                    'APPROVED',
                    'PENDING_FULFILLMENT',
                    'COMPLETED'
                  ]
                  && (
                    request.resource.data.status != 'COMPLETED'
                    || (
                      request.resource.data.currentAssigneeIds.size() == 0
                      && request.resource.data.completedAt == request.time
                    )
                  )
                )
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'previousStatus',
                'currentStep',
                'currentStepType',
                'currentAssigneeIds',
                'previousAssigneeIds',
                'slaRemainingHours',
                'routeKind',
                'dueAt',
                'outcome',
                'fulfillmentRef',
                'completedAt',
                'updatedAt',
                'updatedBy',
                'revision',
                'lastEventId'
              ])
            )
          );

        allow delete: if false;

        match /tasks/{taskId} {
          allow read: if canReadWorkflowRequest(
            companyId,
            get(workflowRequestPath(companyId, workflowRequestId)).data
          );

          allow create: if validWorkflowTaskCreate(
            companyId,
            workflowRequestId,
            taskId
          );

          allow update: if activeMember(companyId)
            && (
              (
                resource.data.assigneeUid == request.auth.uid
                && (
                  get(
                    workflowRequestPath(
                      companyId,
                      workflowRequestId
                    )
                  ).data.delegationId == ''
                  || activeDelegationFor(
                    companyId,
                    get(
                      workflowRequestPath(
                        companyId,
                        workflowRequestId
                      )
                    ).data.delegationId,
                    get(
                      delegationPath(
                        companyId,
                        get(
                          workflowRequestPath(
                            companyId,
                            workflowRequestId
                          )
                        ).data.delegationId
                      )
                    ).data.delegatorUid,
                    request.auth.uid
                  )
                )
              )
              || admin(companyId)
              || (
                get(
                  workflowRequestPath(companyId, workflowRequestId)
                ).data.requesterUid == request.auth.uid
                && getAfter(
                  workflowRequestPath(companyId, workflowRequestId)
                ).data.status == 'WITHDRAWN'
                && request.resource.data.status == 'CANCELLED'
                && request.resource.data.decision == 'cancel'
              )
              || (
                managerActor(companyId)
                && get(
                  workflowRequestPath(companyId, workflowRequestId)
                ).data.delegationId != ''
                && get(
                  delegationPath(
                    companyId,
                    get(
                      workflowRequestPath(companyId, workflowRequestId)
                    ).data.delegationId
                  )
                ).data.delegatorUid == request.auth.uid
              )
            )
            && resource.data.status == 'PENDING'
            && request.resource.data.status in [
              'APPROVED',
              'REJECTED',
              'NEEDS_INFORMATION',
              'CANCELLED'
            ]
            && request.resource.data.decision in [
              'approve',
              'reject',
              'needs_information',
              'cancel'
            ]
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 2000
            && request.resource.data.actedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'decision',
              'note',
              'actedAt',
              'updatedAt',
              'updatedBy'
            ]);

          allow delete: if false;
        }

        match /events/{eventId} {
          allow read: if canReadWorkflowRequest(
            companyId,
            get(workflowRequestPath(companyId, workflowRequestId)).data
          );

          allow create: if validWorkflowEventCreate(
            companyId,
            workflowRequestId,
            eventId
          );

          allow update, delete: if false;
        }

        match /comments/{commentId} {
          allow read: if canReadWorkflowRequest(
              companyId,
              get(workflowRequestPath(companyId, workflowRequestId)).data
            )
            && (
              resource.data.visibility == 'participants'
              || admin(companyId)
            );

          allow create: if activeMember(companyId)
            && canReadWorkflowRequest(
              companyId,
              get(workflowRequestPath(companyId, workflowRequestId)).data
            )
            && request.resource.data.id == commentId
            && request.resource.data.companyId == companyId
            && request.resource.data.requestId == workflowRequestId
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName is string
            && request.resource.data.authorRole is string
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 2000
            && request.resource.data.visibility in [
              'participants',
              'hr_only'
            ]
            && (
              request.resource.data.visibility == 'participants'
              || admin(companyId)
            )
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly([
              'id',
              'companyId',
              'requestId',
              'authorUid',
              'authorName',
              'authorRole',
              'body',
              'visibility',
              'createdAt'
            ]);

          allow update, delete: if false;
        }

        match /attachments/{attachmentId} {
          allow read: if canReadWorkflowRequest(
            companyId,
            get(workflowRequestPath(companyId, workflowRequestId)).data
          );

          allow create: if activeMember(companyId)
            && canReadWorkflowRequest(
              companyId,
              get(workflowRequestPath(companyId, workflowRequestId)).data
            )
            && request.resource.data.id == attachmentId
            && request.resource.data.companyId == companyId
            && request.resource.data.requestId == workflowRequestId
            && request.resource.data.addedBy == request.auth.uid
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 180
            && request.resource.data.url is string
            && request.resource.data.url.matches('^https://.+$')
            && request.resource.data.contentType is string
            && request.resource.data.size is int
            && request.resource.data.size >= 0
            && request.resource.data.size <= 10485760
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly([
              'id',
              'companyId',
              'requestId',
              'addedBy',
              'name',
              'url',
              'contentType',
              'size',
              'createdAt'
            ]);

          allow update, delete: if false;
        }
      }

      match /delegations/{delegationId} {
        allow read: if admin(companyId)
          || (
            activeMember(companyId)
            && (
              resource.data.delegatorUid == request.auth.uid
              || resource.data.delegateUid == request.auth.uid
            )
          );

        allow create: if activeMember(companyId)
          && (
            request.resource.data.delegatorUid == request.auth.uid
            || admin(companyId)
          )
          && request.resource.data.id == delegationId
          && request.resource.data.companyId == companyId
          && request.resource.data.delegateUid is string
          && request.resource.data.delegateUid
            != request.resource.data.delegatorUid
          && exists(
            memberPath(companyId, request.resource.data.delegateUid)
          )
          && (
            get(
              memberPath(companyId, request.resource.data.delegateUid)
            ).data.role in ['super_admin', 'hr_admin', 'manager']
            || get(
              memberPath(companyId, request.resource.data.delegateUid)
            ).data.isManager == true
          )
          && request.resource.data.startAt is timestamp
          && request.resource.data.endAt is timestamp
          && request.resource.data.startAt <= request.time
          && request.resource.data.endAt > request.time
          && request.resource.data.endAt > request.resource.data.startAt
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'id',
            'companyId',
            'delegatorUid',
            'delegateUid',
            'startAt',
            'endAt',
            'status',
            'createdAt',
            'createdBy',
            'updatedAt',
            'updatedBy'
          ]);

        allow update: if activeMember(companyId)
          && (
            resource.data.delegatorUid == request.auth.uid
            || admin(companyId)
          )
          && request.resource.data.status == 'cancelled'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if activeMember(companyId)
          && (
            resource.data.recipientUid == request.auth.uid
            || admin(companyId)
          );

        allow create: if activeMember(companyId)
          && request.resource.data.id == notificationId
          && request.resource.data.companyId == companyId
          && request.resource.data.recipientUid is string
          && exists(
            memberPath(companyId, request.resource.data.recipientUid)
          )
          && request.resource.data.requestId is string
          && existsAfter(
            workflowRequestPath(
              companyId,
              request.resource.data.requestId
            )
          )
          && canReadWorkflowRequest(
            companyId,
            getAfter(
              workflowRequestPath(
                companyId,
                request.resource.data.requestId
              )
            ).data
          )
          && (
            request.resource.data.recipientUid == request.auth.uid
            || request.resource.data.recipientUid
              == getAfter(
                workflowRequestPath(
                  companyId,
                  request.resource.data.requestId
                )
              ).data.requesterUid
            || getAfter(
              workflowRequestPath(
                companyId,
                request.resource.data.requestId
              )
            ).data.currentAssigneeIds.hasAny([
              request.resource.data.recipientUid
            ])
          )
          && request.resource.data.titleEn is string
          && request.resource.data.titleEn.size() <= 160
          && request.resource.data.titleAr is string
          && request.resource.data.titleAr.size() <= 160
          && request.resource.data.bodyEn is string
          && request.resource.data.bodyEn.size() <= 500
          && request.resource.data.bodyAr is string
          && request.resource.data.bodyAr.size() <= 500
          && request.resource.data.kind in [
            'assignment',
            'status',
            'information',
            'sla'
          ]
          && request.resource.data.href is string
          && request.resource.data.href.size() <= 300
          && request.resource.data.href.matches(
            '^(requests|approvals|hr-operations)[.]html[?]v=[0-9.]+&request=[A-Za-z0-9_-]+$'
          )
          && request.resource.data.readAt == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'id',
            'companyId',
            'requestId',
            'recipientUid',
            'titleEn',
            'titleAr',
            'bodyEn',
            'bodyAr',
            'kind',
            'href',
            'readAt',
            'createdAt',
            'createdBy'
          ]);

        allow update: if activeMember(companyId)
          && resource.data.recipientUid == request.auth.uid
          && resource.data.readAt == null
          && request.resource.data.readAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readAt'
          ]);

        allow delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if admin(companyId);

        allow create: if signedIn()
          && activeMemberAfter(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.actorId == request.auth.uid
          && request.auth.token.email is string
          && request.resource.data.actorEmail == request.auth.token.email
          && request.resource.data.action is string
          && request.resource.data.action.size() > 0
          && request.resource.data.action.size() <= 100
          && request.resource.data.targetId is string
          && request.resource.data.targetId.size() > 0
          && request.resource.data.targetId.size() <= 100
          && request.resource.data.details is map
          && request.resource.data.createdAt == request.time
          && auditMutationBacksAction(
            companyId,
            request.resource.data.action,
            request.resource.data.targetId
          )
          && (
            request.resource.data.action == 'company.created'
            || admin(companyId)
          )
          && request.resource.data.keys().hasOnly([
            'companyId',
            'actorId',
            'actorEmail',
            'action',
            'targetId',
            'details',
            'createdAt'
          ]);

        allow update, delete: if false;
      }
    }
  }
}
