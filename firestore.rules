          )
          && getAfter(
            workflowPath(companyId, request.resource.data.workflowId)
          ).data.requestTypeCode == request.resource.data.code
          && getAfter(
            workflowPath(companyId, request.resource.data.workflowId)
          ).data.version == request.resource.data.version
          && getAfter(
            workflowPath(companyId, request.resource.data.workflowId)
