rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(companyId, uid) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/members/$(uid);
    }

    function companyPath(companyId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId);
    }

    function branchPath(companyId, branchId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/branches/$(branchId);
    }

    function locationPath(companyId, locationId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/locations/$(locationId);
    }

    function departmentPath(companyId, departmentId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/departments/$(departmentId);
    }

    function teamPath(companyId, teamId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/teams/$(teamId);
    }

    function jobGradePath(companyId, gradeId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/jobGrades/$(gradeId);
    }

    function jobTitlePath(companyId, jobTitleId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/jobTitles/$(jobTitleId);
    }

    function positionPath(companyId, positionId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/positions/$(positionId);
    }

    function employeePath(companyId, employeeId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/employees/$(employeeId);
    }

    function employeeMovementPath(companyId, movementId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/employeeMovements/$(movementId);
    }

    function requestTypePath(companyId, requestTypeId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/requestTypes/$(requestTypeId);
    }

    function workflowPath(companyId, workflowId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/workflowDefinitions/$(workflowId);
    }

    function workflowRequestPath(companyId, requestId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/requests/$(requestId);
    }

    function delegationPath(companyId, delegationId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/delegations/$(delegationId);
    }

    function workflowRequestEventPath(companyId, requestId, eventId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/requests/$(requestId)/events/$(eventId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/nasna_users/$(uid);
    }

    function member(companyId) {
      return get(memberPath(companyId, request.auth.uid));
    }

    function memberAfter(companyId, uid) {
      return getAfter(memberPath(companyId, uid));
    }

    function activeMember(companyId) {
      return signedIn()
        && member(companyId).data.status == 'active';
    }

    function activeMemberAfter(companyId) {
      return signedIn()
        && memberAfter(companyId, request.auth.uid).data.status == 'active';
    }

    function roleIn(companyId, roles) {
      return signedIn()
        && member(companyId).data.status == 'active'
        && member(companyId).data.role in roles;
    }

    function admin(companyId) {
      return roleIn(companyId, ['super_admin', 'hr_admin']);
    }

    function superAdmin(companyId) {
      return roleIn(companyId, ['super_admin']);
    }

    function managerActor(companyId) {
      return signedIn()
        && member(companyId).data.status == 'active'
        && (
          member(companyId).data.role == 'manager'
          || member(companyId).data.isManager == true
        );
    }

    function requestTerminal(status) {
      return status in [
        'COMPLETED',
        'REJECTED',
        'WITHDRAWN',
        'CANCELLED'
      ];
    }

    function requestOwner(data) {
      return signedIn() && data.requesterUid == request.auth.uid;
    }

    function requestAssigned(data) {
      return signedIn()
        && data.currentAssigneeIds is list
        && data.currentAssigneeIds.hasAny([request.auth.uid]);
    }

    function requestLineManager(companyId, data) {
      return activeMember(companyId)
        && data.confidentiality == 'normal'
        && member(companyId).data.employeeId is string
        && member(companyId).data.employeeId == data.managerEmployeeId;
    }

    function canReadWorkflowRequest(companyId, data) {
      return activeMember(companyId)
        && (
          member(companyId).data.role in ['super_admin', 'hr_admin']
          || requestOwner(data)
          || requestAssigned(data)
          || (
            data.confidentiality == 'normal'
            && member(companyId).data.employeeId is string
            && member(companyId).data.employeeId == data.managerEmployeeId
          )
        );
    }

    function validRequestTypeShape(companyId, requestTypeId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'version',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'category',
          'confidentiality',
          'subjectMode',
          'initialResolver',
          'formSchema',
          'workflowId',
          'status',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'version',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'category',
          'confidentiality',
          'subjectMode',
          'initialResolver',
          'formSchema',
          'workflowId',
          'status',
          'createdAt',
          'createdBy',
          'retiredAt',
          'retiredBy'
        ])
        && request.resource.data.id == requestTypeId
        && request.resource.data.companyId == companyId
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[a-z][a-z0-9_]{2,39}$')
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.nameEn is string
        && request.resource.data.nameEn.size() > 0
        && request.resource.data.nameEn.size() <= 120
        && request.resource.data.nameAr is string
        && request.resource.data.nameAr.size() > 0
        && request.resource.data.nameAr.size() <= 120
        && request.resource.data.descriptionEn is string
        && request.resource.data.descriptionEn.size() <= 500
        && request.resource.data.descriptionAr is string
        && request.resource.data.descriptionAr.size() <= 500
        && request.resource.data.category in [
          'general',
          'personal_data',
          'documents',
          'confidential',
          'team',
          'correction',
          'custom'
        ]
        && request.resource.data.confidentiality in ['normal', 'restricted']
        && request.resource.data.subjectMode in ['self', 'direct_report']
        && request.resource.data.initialResolver in ['direct_manager', 'hr']
        && request.resource.data.formSchema is list
        && request.resource.data.formSchema.size() > 0
        && request.resource.data.formSchema.size() <= 30
        && request.resource.data.workflowId is string
        && request.resource.data.workflowId.size() > 0
        && request.resource.data.workflowId.size() <= 100
        && request.resource.data.status in ['published', 'retired']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string;
    }

    function validWorkflowShape(companyId, workflowId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'requestTypeCode',
          'version',
          'steps',
          'slaHours',
          'status',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'requestTypeCode',
          'version',
          'steps',
          'slaHours',
          'status',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.id == workflowId
        && request.resource.data.companyId == companyId
        && request.resource.data.requestTypeCode is string
        && request.resource.data.requestTypeCode.matches('^[a-z][a-z0-9_]{2,39}$')
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.steps is list
        && request.resource.data.steps.size() > 0
        && request.resource.data.steps.size() <= 20
        && request.resource.data.slaHours is int
        && request.resource.data.slaHours >= 1
        && request.resource.data.slaHours <= 8760
        && (
          request.resource.data.initialResolver != 'direct_manager'
          || request.resource.data.slaHours >= 2
        )
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string;
    }

    function validWorkflowDraftShape(companyId, draftId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'category',
          'confidentiality',
          'subjectMode',
          'initialResolver',
          'slaHours',
          'formSchema',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'category',
          'confidentiality',
          'subjectMode',
          'initialResolver',
          'slaHours',
          'formSchema',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == draftId
        && request.resource.data.companyId == companyId
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[a-z][a-z0-9_]{2,39}$')
        && request.resource.data.nameEn is string
        && request.resource.data.nameEn.size() > 0
        && request.resource.data.nameEn.size() <= 120
        && request.resource.data.nameAr is string
        && request.resource.data.nameAr.size() > 0
        && request.resource.data.nameAr.size() <= 120
        && request.resource.data.descriptionEn is string
        && request.resource.data.descriptionEn.size() <= 500
        && request.resource.data.descriptionAr is string
        && request.resource.data.descriptionAr.size() <= 500
        && request.resource.data.category in [
          'general',
          'personal_data',
          'documents',
          'confidential',
          'team',
          'correction',
          'custom'
        ]
        && request.resource.data.confidentiality in ['normal', 'restricted']
        && request.resource.data.subjectMode in ['self', 'direct_report']
        && request.resource.data.initialResolver in ['direct_manager', 'hr']
        && (
          request.resource.data.confidentiality == 'normal'
          || request.resource.data.initialResolver == 'hr'
        )
        && request.resource.data.slaHours is int
        && request.resource.data.slaHours >= 1
        && request.resource.data.slaHours <= 8760
        && request.resource.data.formSchema is list
        && request.resource.data.formSchema.size() > 0
        && request.resource.data.formSchema.size() <= 30
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validWorkflowRequestShape(companyId, workflowRequestId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'requestNumber',
          'typeId',
          'typeCode',
          'typeVersion',
          'workflowId',
          'requesterUid',
          'requesterEmployeeId',
          'requesterName',
          'subjectEmployeeId',
          'subjectName',
          'managerEmployeeId',
          'status',
          'currentStep',
          'currentStepType',
          'currentAssigneeIds',
          'routeKind',
          'payload',
          'confidentiality',
          'priority',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'revision',
          'previousStatus',
          'previousAssigneeIds',
          'delegationId',
          'originalAssigneeIds',
          'dueAt',
          'submittedAt',
          'lastEventId',
          'outcome',
          'fulfillmentRef',
          'completedAt',
          'withdrawnAt'
        ])
        && request.resource.data.id == workflowRequestId
        && request.resource.data.companyId == companyId
        && request.resource.data.requestNumber.matches(
          '^REQ-([A-Z0-9]{2,8}-)?[0-9]{4}-[A-Z0-9]{5,20}$'
        )
        && request.resource.data.typeVersion is int
        && request.resource.data.typeVersion >= 1
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterName.size() <= 140
        && request.resource.data.subjectName.size() > 0
        && request.resource.data.subjectName.size() <= 140
        && request.resource.data.status in [
          'DRAFT',
          'SUBMITTED',
          'PENDING_APPROVAL',
          'NEEDS_INFORMATION',
          'PENDING_FULFILLMENT',
          'APPROVED',
          'COMPLETED',
          'REJECTED',
          'WITHDRAWN',
          'CANCELLED'
        ]
        && request.resource.data.previousStatus is string
        && request.resource.data.currentStep is int
        && request.resource.data.currentStep >= 0
        && request.resource.data.currentStep <= 20
        && request.resource.data.currentStepType in [
          '',
          'approval',
          'acknowledgement',
          'fulfillment',
          'automated_validation'
        ]
        && request.resource.data.currentAssigneeIds is list
        && request.resource.data.currentAssigneeIds.size() <= 20
        && request.resource.data.previousAssigneeIds.size() <= 20
        && request.resource.data.delegationId.size() <= 80
        && request.resource.data.originalAssigneeIds.size() <= 20
        && request.resource.data.routeKind in ['', 'manager', 'hr']
        && request.resource.data.payload is map
        && request.resource.data.confidentiality in ['normal', 'restricted']
        && request.resource.data.priority in ['normal', 'high', 'urgent']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.revision is int
        && request.resource.data.revision >= 0
        && (
          !request.resource.data.keys().hasAny(['slaRemainingHours'])
          || (
            request.resource.data.slaRemainingHours is number
            && request.resource.data.slaRemainingHours >= 0
            && request.resource.data.slaRemainingHours <= 8760
          )
        )
        && request.resource.data.lastEventId.size() > 0
        && request.resource.data.lastEventId.size() <= 80
        && (
          request.resource.data.completedAt == null
          || request.resource.data.completedAt is timestamp
        )
        && (
          request.resource.data.withdrawnAt == null
          || request.resource.data.withdrawnAt is timestamp
        );
    }

    function validRequestSubjectData(
      companyId,
      requestType,
      requesterEmployeeId,
      requesterEmployee
    ) {
      return requesterEmployeeId is string
        && requesterEmployeeId == request.resource.data.requesterEmployeeId
        && requesterEmployee.authUid == request.auth.uid
        && (
          (
            requestType.subjectMode == 'self'
            && request.resource.data.subjectEmployeeId == requesterEmployeeId
          )
          || (
            requestType.subjectMode == 'direct_report'
            && get(
              employeePath(companyId, request.resource.data.subjectEmployeeId)
            ).data.managerEmployeeId == requesterEmployeeId
          )
        );
    }

    function validInitialRequestRouteData(
      companyId,
      requestType,
      requesterEmployee
    ) {
      let hasManager = requesterEmployee.managerEmployeeId != '';
      let hasManagerRecord = hasManager
        && exists(
          employeePath(companyId, requesterEmployee.managerEmployeeId)
        );
      let managerUid = hasManagerRecord
        ? get(
            employeePath(companyId, requesterEmployee.managerEmployeeId)
          ).data.authUid
        : '';
      let hasValidManager = hasManagerRecord
        && managerUid != request.auth.uid
        && exists(memberPath(companyId, managerUid))
        && get(memberPath(companyId, managerUid)).data.status == 'active';
      return (
          request.resource.data.status == 'DRAFT'
          && request.resource.data.routeKind == ''
          && request.resource.data.currentAssigneeIds.size() == 0
          && request.resource.data.submittedAt == null
        )
        || (
          request.resource.data.status in [
            'SUBMITTED',
            'PENDING_APPROVAL',
            'PENDING_FULFILLMENT'
          ]
          && request.resource.data.submittedAt == request.time
          && request.resource.data.currentAssigneeIds.size() > 0
          && !request.resource.data.currentAssigneeIds.hasAny([
            request.auth.uid
          ])
          && (
            (
              requestType.initialResolver == 'direct_manager'
              && hasValidManager
              && request.resource.data.routeKind == 'manager'
              && request.resource.data.currentAssigneeIds[0] == managerUid
              && request.resource.data.managerEmployeeId
                == requesterEmployee.managerEmployeeId
              && request.resource.data.status == 'PENDING_APPROVAL'
            )
            || (
              (
                requestType.initialResolver == 'hr'
                || !hasValidManager
              )
              && request.resource.data.routeKind == 'hr'
              && request.resource.data.currentAssigneeIds.size() > 0
              && get(
                memberPath(
                  companyId,
                  request.resource.data.currentAssigneeIds[0]
                )
              ).data.role in ['super_admin', 'hr_admin']
              && request.resource.data.status == 'PENDING_FULFILLMENT'
            )
          )
        );
    }

    function validInitialRequestRoute(companyId) {
      let requestType = get(
        requestTypePath(companyId, request.resource.data.typeId)
      ).data;
      let requesterEmployee = get(
        employeePath(companyId, request.resource.data.requesterEmployeeId)
      ).data;
      return validInitialRequestRouteData(
        companyId,
        requestType,
        requesterEmployee
      );
    }

    function validWorkflowRequestCreate(companyId, workflowRequestId) {
      let requestType = get(
        requestTypePath(companyId, request.resource.data.typeId)
      ).data;
      let requesterEmployeeId = member(companyId).data.employeeId;
      let requesterEmployee = get(
        employeePath(companyId, requesterEmployeeId)
      ).data;
      return activeMember(companyId)
        && validWorkflowRequestShape(companyId, workflowRequestId)
        && exists(requestTypePath(companyId, request.resource.data.typeId))
        && requestType.status == 'published'
        && requestType.code == request.resource.data.typeCode
        && requestType.version == request.resource.data.typeVersion
        && requestType.workflowId == request.resource.data.workflowId
        && requestType.confidentiality
          == request.resource.data.confidentiality
        && exists(workflowPath(companyId, request.resource.data.workflowId))
        && validRequestSubjectData(
          companyId,
          requestType,
          requesterEmployeeId,
          requesterEmployee
        )
        && validInitialRequestRouteData(
          companyId,
          requestType,
          requesterEmployee
        )
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.revision == 0
        && existsAfter(
          workflowRequestEventPath(
            companyId,
            workflowRequestId,
            request.resource.data.lastEventId
          )
        )
        && getAfter(
          workflowRequestEventPath(
            companyId,
            workflowRequestId,
            request.resource.data.lastEventId
          )
        ).data.actorUid == request.auth.uid
        && request.resource.data.previousStatus == ''
        && request.resource.data.previousAssigneeIds.size() == 0
        && request.resource.data.delegationId == ''
        && request.resource.data.originalAssigneeIds.size() == 0
        && request.resource.data.completedAt == null
        && request.resource.data.withdrawnAt == null;
    }

    function validWorkflowRequestUpdate(companyId, workflowRequestId) {
      return request.resource.data.id == resource.data.id
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.requestNumber == resource.data.requestNumber
        && request.resource.data.typeId == resource.data.typeId
        && request.resource.data.typeCode == resource.data.typeCode
        && request.resource.data.typeVersion == resource.data.typeVersion
        && request.resource.data.workflowId == resource.data.workflowId
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.requesterEmployeeId
          == resource.data.requesterEmployeeId
        && request.resource.data.subjectEmployeeId
          == resource.data.subjectEmployeeId
        && request.resource.data.managerEmployeeId
          == resource.data.managerEmployeeId
        && request.resource.data.confidentiality
          == resource.data.confidentiality
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.lastEventId != resource.data.lastEventId
        && existsAfter(
          workflowRequestEventPath(
            companyId,
            workflowRequestId,
            request.resource.data.lastEventId
          )
        )
        && getAfter(
          workflowRequestEventPath(
            companyId,
            workflowRequestId,
            request.resource.data.lastEventId
          )
        ).data.actorUid == request.auth.uid
        && !requestTerminal(resource.data.status);
    }

    function validUserShape(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.activeCompanyId is string
        && request.resource.data.status in ['active', 'disabled'];
    }

    function validStructureCode(value) {
      return value is string
        && value.matches('^[A-Z0-9][A-Z0-9-]{1,19}$');
    }

    function validStructureName(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 100;
    }

    function validBranchShape(companyId, branchId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == branchId
        && request.resource.data.companyId == companyId
        && request.resource.data.code == branchId
        && validStructureCode(request.resource.data.code)
        && validStructureName(request.resource.data.nameEn)
        && validStructureName(request.resource.data.nameAr)
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validLocationShape(companyId, locationId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'branchId',
          'nameEn',
          'nameAr',
          'city',
          'address',
          'timezone',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'branchId',
          'nameEn',
          'nameAr',
          'city',
          'address',
          'timezone',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == locationId
        && request.resource.data.companyId == companyId
        && request.resource.data.code == locationId
        && validStructureCode(request.resource.data.code)
        && validStructureCode(request.resource.data.branchId)
        && validStructureName(request.resource.data.nameEn)
        && validStructureName(request.resource.data.nameAr)
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 80
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 200
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() > 0
        && request.resource.data.timezone.size() <= 80
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validDepartmentShape(companyId, departmentId) {
