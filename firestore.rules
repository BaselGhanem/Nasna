          'weekStartsOn',
          'workingDays',
          'workdayStart',
          'workdayEnd',
          'dailyMinutes',
          'maxDailyMinutes',
          'maxWeeklyMinutes',
          'minRestMinutes',
          'conflictMode',
          'holidayWorkMode',
          'effectiveFrom',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == policyId
        && request.resource.data.companyId == companyId
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.version <= 10000
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() > 0
        && request.resource.data.timezone.size() <= 80
        && request.resource.data.weekStartsOn is int
        && request.resource.data.weekStartsOn >= 0
        && request.resource.data.weekStartsOn <= 6
        && request.resource.data.workingDays is list
        && request.resource.data.workingDays.size() >= 1
        && request.resource.data.workingDays.size() <= 7
        && request.resource.data.workingDays.hasOnly([
          0, 1, 2, 3, 4, 5, 6
        ])
        && validClockTime(request.resource.data.workdayStart)
        && validClockTime(request.resource.data.workdayEnd)
        && request.resource.data.dailyMinutes is int
        && request.resource.data.dailyMinutes >= 60
        && request.resource.data.dailyMinutes <= 1440
        && request.resource.data.maxDailyMinutes is int
        && request.resource.data.maxDailyMinutes
          >= request.resource.data.dailyMinutes
        && request.resource.data.maxDailyMinutes <= 1440
        && request.resource.data.maxWeeklyMinutes is int
        && request.resource.data.maxWeeklyMinutes
          >= request.resource.data.maxDailyMinutes
        && request.resource.data.maxWeeklyMinutes <= 10080
        && request.resource.data.minRestMinutes is int
        && request.resource.data.minRestMinutes >= 0
        && request.resource.data.minRestMinutes <= 1440
        && request.resource.data.conflictMode in ['block', 'warn']
        && request.resource.data.holidayWorkMode in ['block', 'warn']
        && validIsoDate(request.resource.data.effectiveFrom)
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
