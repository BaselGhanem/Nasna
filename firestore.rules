        && segment.endAt > segment.startAt
        && segment.breakMinutes is int
        && segment.breakMinutes >= 0
        && segment.breakMinutes <= 240
        && segment.locationId is string
        && exists(locationPath(companyId, segment.locationId))
        && (
          requireActiveLocation == false
          || get(
            locationPath(companyId, segment.locationId)
          ).data.status == 'active'
        );
    }

    function validConflictCheck(conflictCheck) {
      return conflictCheck is map
        && conflictCheck.keys().hasAll([
          'policyId',
          'result',
          'reason'
        ])
        && conflictCheck.keys().hasOnly([
          'policyId',
          'result',
          'reason'
        ])
        && conflictCheck.policyId is string
        && conflictCheck.result in [
          'pending',
          'passed',
          'override'
        ]
        && conflictCheck.reason is string
        && conflictCheck.reason.size() <= 500;
    }

    function assignmentMatchesActiveTemplate(companyId, data) {
      let template = get(
        shiftTemplatePath(companyId, data.templateId)
      ).data;
      return template.status == 'active'
        && get(locationPath(companyId, data.locationId)).data.status
          == 'active'
        && data.templateKind == template.kind
        && data.flexWindowMinutes == template.flexWindowMinutes
        && data.segments.size() == template.segments.size()
        && data.totalMinutes == template.totalMinutes
        && data.segments[0].breakMinutes
          == template.segments[0].breakMinutes
        && (
          data.segments.size() == 1
          || data.segments[1].breakMinutes
            == template.segments[1].breakMinutes
        );
    }

    function validShiftAssignmentShape(companyId, assignmentId) {
      let data = request.resource.data;
      let employee = get(
        employeePath(companyId, data.employeeId)
      ).data;
      let location = get(
        locationPath(companyId, data.locationId)
      ).data;
      let template = get(
        shiftTemplatePath(companyId, data.templateId)
      ).data;
      return data.keys().hasAll([
          'id',
          'companyId',
          'rosterId',
          'rosterRevision',
          'employeeId',
          'employeeAuthUid',
          'managerEmployeeId',
          'branchId',
          'locationId',
          'workDate',
          'templateId',
          'templateKind',
          'flexWindowMinutes',
          'segments',
          'totalMinutes',
          'status',
          'version',
          'previousAssignmentId',
          'supersededBy',
          'sourceRequestId',
          'conflictCheck',
          'createdAt',
          'createdBy',
          'publishedAt',
          'publishedBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'id',
          'companyId',
          'rosterId',
          'rosterRevision',
          'employeeId',
          'employeeAuthUid',
          'managerEmployeeId',
          'branchId',
          'locationId',
          'workDate',
          'templateId',
          'templateKind',
          'flexWindowMinutes',
          'segments',
          'totalMinutes',
          'status',
          'version',
          'previousAssignmentId',
          'supersededBy',
          'sourceRequestId',
          'conflictCheck',
          'createdAt',
          'createdBy',
          'publishedAt',
          'publishedBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.id == assignmentId
        && data.companyId == companyId
        && data.rosterId is string
        && data.rosterId.size() > 0
        && data.rosterId.size() <= 80
        && data.rosterRevision is int
        && data.rosterRevision >= 0
        && data.employeeId is string
        && data.employeeAuthUid == employee.authUid
        && data.managerEmployeeId == employee.managerEmployeeId
        && data.branchId == employee.branchId
        && data.locationId is string
        && (
          data.status != 'draft'
          || location.status == 'active'
        )
        && validIsoDate(data.workDate)
        && data.templateId is string
        && (
          data.status != 'draft'
          || template.status == 'active'
        )
        && (
          data.status != 'draft'
          || data.templateKind == template.kind
        )
        && data.flexWindowMinutes is int
        && data.flexWindowMinutes >= 0
        && data.flexWindowMinutes <= 240
        && data.segments is list
        && data.segments.size() >= 1
        && data.segments.size() <= 2
        && validPublishedShiftSegment(
          companyId,
          data.segments[0],
          data.templateId,
          data.status == 'draft'
        )
        && data.segments[0].locationId == data.locationId
        && (
          data.segments.size() == 1
          || (
            validPublishedShiftSegment(
              companyId,
              data.segments[1],
              data.templateId,
              data.status == 'draft'
            )
            && data.segments[1].locationId == data.locationId
          )
        )
        && data.totalMinutes is int
        && data.totalMinutes >= 1
        && data.totalMinutes <= 1440
        && data.status in [
          'draft',
          'published',
          'superseded'
        ]
        && (
          data.status != 'draft'
          || assignmentMatchesActiveTemplate(companyId, data)
        )
        && data.version is int
        && data.version >= 0
        && data.previousAssignmentId is string
        && data.previousAssignmentId.size() <= 180
        && data.supersededBy is string
        && data.supersededBy.size() <= 180
        && data.sourceRequestId is string
        && data.sourceRequestId.size() <= 80
        && validConflictCheck(data.conflictCheck)
        && data.createdAt is timestamp
        && data.createdBy is string
        && (
          data.publishedAt == null
          || data.publishedAt is timestamp
        )
        && data.publishedBy is string
        && data.updatedAt is timestamp
        && data.updatedBy is string;
    }

    function validScheduleLockShape(companyId, lockId) {
      let data = request.resource.data;
      let assignment = getAfter(
        shiftAssignmentPath(companyId, data.currentAssignmentId)
      ).data;
      return data.keys().hasAll([
          'id',
          'companyId',
          'employeeId',
          'employeeAuthUid',
          'managerEmployeeId',
          'workDate',
          'currentAssignmentId',
          'version',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'id',
          'companyId',
          'employeeId',
          'employeeAuthUid',
          'managerEmployeeId',
          'workDate',
          'currentAssignmentId',
          'version',
          'updatedAt',
          'updatedBy'
        ])
        && data.id == lockId
        && data.companyId == companyId
        && data.employeeId is string
        && data.employeeAuthUid is string
        && data.managerEmployeeId is string
        && validIsoDate(data.workDate)
        && data.currentAssignmentId is string
        && data.currentAssignmentId.size() > 0
        && data.currentAssignmentId.size() <= 180
        && data.version is int
        && data.version >= 1
        && assignment.status == 'published'
        && assignment.employeeId == data.employeeId
        && assignment.employeeAuthUid == data.employeeAuthUid
        && assignment.managerEmployeeId == data.managerEmployeeId
        && assignment.workDate == data.workDate
        && assignment.version == data.version
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validRequestShiftSegment(segment, templateId, locationId) {
      return segment is map
        && segment.keys().hasAll([
          'shiftTemplateId',
          'startAt',
          'endAt',
          'breakMinutes',
          'locationId'
        ])
        && segment.keys().hasOnly([
          'shiftTemplateId',
          'startAt',
          'endAt',
          'breakMinutes',
          'locationId'
        ])
        && segment.shiftTemplateId == templateId
        && segment.locationId == locationId
        && segment.startAt is timestamp
        && segment.endAt is timestamp
        && segment.endAt > segment.startAt
        && segment.breakMinutes is int
        && segment.breakMinutes >= 0
        && segment.breakMinutes <= 240;
    }

    function validRequestShiftAssignmentShape(
      companyId,
      assignmentId,
      data
    ) {
      return data.keys().hasAll([
          'id',
          'companyId',
          'rosterId',
          'rosterRevision',
          'employeeId',
          'employeeAuthUid',
          'managerEmployeeId',
          'branchId',
          'locationId',
          'workDate',
          'templateId',
          'templateKind',
          'flexWindowMinutes',
          'segments',
          'totalMinutes',
          'status',
          'version',
          'previousAssignmentId',
          'supersededBy',
          'sourceRequestId',
          'conflictCheck',
          'createdAt',
          'createdBy',
          'publishedAt',
          'publishedBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'id',
          'companyId',
          'rosterId',
          'rosterRevision',
          'employeeId',
          'employeeAuthUid',
          'managerEmployeeId',
          'branchId',
          'locationId',
          'workDate',
          'templateId',
          'templateKind',
          'flexWindowMinutes',
          'segments',
          'totalMinutes',
          'status',
          'version',
          'previousAssignmentId',
          'supersededBy',
          'sourceRequestId',
          'conflictCheck',
          'createdAt',
          'createdBy',
          'publishedAt',
          'publishedBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.id == assignmentId
        && data.companyId == companyId
        && data.rosterRevision == 0
        && data.employeeId is string
        && data.employeeAuthUid is string
        && data.managerEmployeeId is string
        && data.branchId is string
        && data.locationId is string
        && validIsoDate(data.workDate)
        && data.templateId is string
        && data.templateKind is string
        && data.flexWindowMinutes is int
        && data.flexWindowMinutes >= 0
        && data.flexWindowMinutes <= 240
        && data.segments is list
        && data.segments.size() >= 1
        && data.segments.size() <= 2
        && validRequestShiftSegment(
          data.segments[0],
          data.templateId,
          data.locationId
        )
        && (
          data.segments.size() == 1
          || validRequestShiftSegment(
            data.segments[1],
            data.templateId,
            data.locationId
          )
        )
        && data.totalMinutes is int
        && data.totalMinutes >= 1
        && data.totalMinutes <= 1440
        && data.status == 'published'
        && data.version is int
        && data.previousAssignmentId is string
        && data.supersededBy == ''
        && data.sourceRequestId is string
        && validConflictCheck(data.conflictCheck)
        && data.createdAt == request.time
        && data.createdBy == request.auth.uid
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validRequestFulfilledShiftCommon(
      companyId,
      assignmentId,
      data,
      completedRequest
    ) {
      let previousAssignment = get(
        shiftAssignmentPath(
          companyId,
          data.previousAssignmentId
        )
      ).data;
      let previousAfter = getAfter(
        shiftAssignmentPath(companyId, data.previousAssignmentId)
      ).data;
      let settings = get(timeSettingsPath(companyId)).data;
      let lockAfter = getAfter(
        scheduleLockPath(
          companyId,
          data.employeeId + '__' + data.workDate
        )
      ).data;
      return admin(companyId)
        && validRequestShiftAssignmentShape(
          companyId,
          assignmentId,
          data
        )
        && data.sourceRequestId is string
        && data.sourceRequestId.size() > 0
        && data.sourceRequestId.size() <= 80
        && data.rosterId == 'REQUEST-' + data.sourceRequestId
        && data.rosterRevision == 0
        && data.status == 'published'
        && assignmentMatchesActiveTemplate(companyId, data)
        && data.version >= 2
        && data.supersededBy == ''
        && data.previousAssignmentId is string
        && data.previousAssignmentId.size() > 0
        && previousAssignment.status == 'published'
        && previousAssignment.employeeId == data.employeeId
        && previousAssignment.employeeAuthUid == data.employeeAuthUid
        && previousAssignment.workDate == data.workDate
        && data.version == previousAssignment.version + 1
        && previousAfter.status == 'superseded'
        && previousAfter.supersededBy == assignmentId
        && data.conflictCheck.policyId == settings.activePolicyId
        && data.conflictCheck.result in [
          'passed',
          'override'
        ]
        && (
          data.conflictCheck.result == 'passed'
          || data.conflictCheck.reason.size() >= 8
        )
        && data.createdAt == request.time
        && data.createdBy == request.auth.uid
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && completedRequest.typeCode in [
          'shift_change',
          'shift_swap'
        ]
        && (
          (
            completedRequest.status == 'PENDING_FULFILLMENT'
            && completedRequest.currentAssigneeIds.hasAny([
              request.auth.uid
            ])
          )
          || (
            completedRequest.status == 'COMPLETED'
            && completedRequest.completedAt == request.time
            && completedRequest.updatedAt == request.time
            && completedRequest.updatedBy == request.auth.uid
            && completedRequest.fulfillmentRef.kind
              == completedRequest.typeCode
            && (
              completedRequest.fulfillmentRef.id == assignmentId
              || completedRequest.fulfillmentRef.colleagueId == assignmentId
            )
          )
        )
        && lockAfter.currentAssignmentId == assignmentId
        && lockAfter.version == data.version;
    }

    function validRequestFulfilledShiftChange(
      companyId,
      assignmentId,
      data,
      completedRequest
    ) {
      let previousAssignment = get(
        shiftAssignmentPath(companyId, data.previousAssignmentId)
      ).data;
      return completedRequest.typeCode == 'shift_change'
        && validRequestFulfilledShiftCommon(
          companyId,
          assignmentId,
          data,
          completedRequest
        )
        && data.previousAssignmentId
          == completedRequest.payload.assignmentId
        && data.templateId
          == completedRequest.payload.requestedShiftTemplateId
        && data.locationId == previousAssignment.locationId;
    }

    function validRequestFulfilledShiftSwap(
      companyId,
      assignmentId,
      data,
      completedRequest
    ) {
      let payload = completedRequest.payload;
      let counterpartId = data.previousAssignmentId == payload.assignmentId
        ? payload.colleagueAssignmentId
        : payload.assignmentId;
      let counterpart = get(
        shiftAssignmentPath(companyId, counterpartId)
      ).data;
      return completedRequest.typeCode == 'shift_swap'
        && validRequestFulfilledShiftCommon(
          companyId,
          assignmentId,
          data,
          completedRequest
        )
        && data.previousAssignmentId in [
          payload.assignmentId,
          payload.colleagueAssignmentId
        ]
        && data.templateId == counterpart.templateId
        && data.locationId == counterpart.locationId;
    }

    function validRequestFulfilledShiftAssignment(
      companyId,
      assignmentId
    ) {
      let data = request.resource.data;
      let completedRequest = getAfter(
        workflowRequestPath(companyId, data.sourceRequestId)
      ).data;
      return (
          completedRequest.typeCode == 'shift_change'
          && validRequestFulfilledShiftChange(
            companyId,
            assignmentId,
            data,
            completedRequest
          )
        )
        || (
          completedRequest.typeCode == 'shift_swap'
          && validRequestFulfilledShiftSwap(
            companyId,
            assignmentId,
            data,
            completedRequest
          )
        );
    }

    function validRequestSupersededShiftUpdate(companyId, assignmentId) {
      let data = request.resource.data;
      let replacement = getAfter(
        shiftAssignmentPath(companyId, data.supersededBy)
      ).data;
      let lock = getAfter(
        scheduleLockPath(
          companyId,
          resource.data.employeeId + '__' + resource.data.workDate
        )
      ).data;
      return admin(companyId)
        && resource.data.status == 'published'
        && data.status == 'superseded'
        && data.id == assignmentId
        && data.supersededBy is string
        && data.supersededBy.size() > 0
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'supersededBy',
          'updatedAt',
          'updatedBy'
        ])
        && replacement.status == 'published'
        && replacement.previousAssignmentId == assignmentId
        && replacement.employeeId == resource.data.employeeId
        && replacement.employeeAuthUid == resource.data.employeeAuthUid
        && replacement.managerEmployeeId
          == resource.data.managerEmployeeId
        && replacement.branchId == resource.data.branchId
        && replacement.workDate == resource.data.workDate
        && replacement.version == resource.data.version + 1
        && replacement.sourceRequestId is string
        && replacement.sourceRequestId.size() > 0
        && lock.currentAssignmentId == data.supersededBy
        && lock.version == replacement.version;
    }

    function validRequestScheduleLockUpdate(companyId, lockId) {
      let data = request.resource.data;
      let assignment = getAfter(
        shiftAssignmentPath(companyId, data.currentAssignmentId)
      ).data;
      let linkedRequest = get(
        workflowRequestPath(companyId, assignment.sourceRequestId)
      ).data;
      return admin(companyId)
        && data.id == lockId
        && data.companyId == resource.data.companyId
        && data.employeeId == resource.data.employeeId
        && data.employeeAuthUid == resource.data.employeeAuthUid
        && data.managerEmployeeId == resource.data.managerEmployeeId
        && data.workDate == resource.data.workDate
        && data.version == resource.data.version + 1
        && data.currentAssignmentId != resource.data.currentAssignmentId
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly([
          'currentAssignmentId',
          'version',
          'updatedAt',
          'updatedBy'
        ])
        && assignment.status == 'published'
        && assignment.employeeId == data.employeeId
        && assignment.employeeAuthUid == data.employeeAuthUid
        && assignment.managerEmployeeId == data.managerEmployeeId
        && assignment.workDate == data.workDate
        && assignment.version == data.version
        && assignment.sourceRequestId is string
        && assignment.sourceRequestId.size() > 0
        && linkedRequest.status == 'PENDING_FULFILLMENT'
        && linkedRequest.currentAssigneeIds.hasAny([request.auth.uid])
        && linkedRequest.typeCode in ['shift_change', 'shift_swap'];
    }

    function validRosterPublishingAssignmentUpdate(
      companyId,
      assignmentId
    ) {
      let data = request.resource.data;
      let rosterBefore = get(
        rosterPath(companyId, resource.data.rosterId)
      ).data;
      let rosterAfter = getAfter(
        rosterPath(companyId, resource.data.rosterId)
      ).data;
      let lockAfter = getAfter(
        scheduleLockPath(
          companyId,
          resource.data.employeeId + '__' + resource.data.workDate
        )
      ).data;
      return canScheduleEmployee(companyId, resource.data.employeeId)
        && resource.data.status == 'draft'
        && data.status == 'published'
        && data.id == assignmentId
        && data.version >= 1
        && data.previousAssignmentId == ''
        && data.supersededBy == ''
        && data.sourceRequestId == ''
        && assignmentMatchesActiveTemplate(companyId, data)
        && data.conflictCheck.policyId
          == resource.data.conflictCheck.policyId
        && data.conflictCheck.result in ['passed', 'override']
        && (
          data.conflictCheck.result == 'passed'
          || (
            admin(companyId)
            && data.conflictCheck.reason.size() >= 8
          )
        )
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'version',
          'previousAssignmentId',
          'conflictCheck',
          'publishedAt',
          'publishedBy',
          'updatedAt',
          'updatedBy'
        ])
        && rosterBefore.status == 'publishing'
        && rosterAfter.status == 'publishing'
        && rosterAfter.revision == data.rosterRevision
        && rosterAfter.publishCompleted
          == rosterBefore.publishCompleted + 1
        && rosterAfter.lastPublishedAssignmentId == assignmentId
        && lockAfter.currentAssignmentId == assignmentId
        && lockAfter.version == data.version;
    }

    function validRosterPublishProgressUpdate(companyId, rosterId) {
      let data = request.resource.data;
      let assignmentBefore = get(
        shiftAssignmentPath(
          companyId,
          data.lastPublishedAssignmentId
        )
      ).data;
      let assignmentAfter = getAfter(
        shiftAssignmentPath(
          companyId,
          data.lastPublishedAssignmentId
        )
      ).data;
      return (
          admin(companyId)
          || (
            managerActor(companyId)
            && resource.data.ownerUid == request.auth.uid
            && resource.data.managerEmployeeId
              == member(companyId).data.employeeId
            && resource.data.scopeKind == 'manager'
          )
        )
        && data.id == rosterId
        && data.companyId == resource.data.companyId
        && data.ownerUid == resource.data.ownerUid
        && data.managerEmployeeId == resource.data.managerEmployeeId
        && data.scopeKind == resource.data.scopeKind
        && data.status == 'publishing'
        && resource.data.status == 'publishing'
        && data.publishCompleted == resource.data.publishCompleted + 1
        && data.publishCompleted <= resource.data.publishTotal
        && data.lastPublishedAssignmentId is string
        && data.lastPublishedAssignmentId.size() > 0
        && data.lastPublishedAssignmentId
          != resource.data.lastPublishedAssignmentId
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly([
          'publishCompleted',
          'lastPublishedAssignmentId',
          'updatedAt',
          'updatedBy'
        ])
        && assignmentBefore.status == 'draft'
        && assignmentAfter.status == 'published'
        && assignmentAfter.rosterId == rosterId
        && assignmentAfter.rosterRevision == resource.data.revision
        && assignmentAfter.updatedAt == request.time
        && assignmentAfter.updatedBy == request.auth.uid;
    }

    function validRosterPublishStartUpdate(companyId, rosterId) {
      let data = request.resource.data;
      return (
          admin(companyId)
          || (
            managerActor(companyId)
            && resource.data.ownerUid == request.auth.uid
            && resource.data.managerEmployeeId
              == member(companyId).data.employeeId
            && resource.data.scopeKind == 'manager'
          )
        )
        && data.id == rosterId
        && data.companyId == resource.data.companyId
        && data.ownerUid == resource.data.ownerUid
        && resource.data.status == 'draft'
        && resource.data.draftState == 'ready'
        && data.status == 'publishing'
        && data.draftState == 'ready'
        && data.publishTotal == resource.data.assignmentCount
        && data.publishCompleted == 0
        && data.publishToken is string
        && data.publishToken.size() >= 8
        && data.publishToken.size() <= 80
        && data.publishConflictResult in ['passed', 'override']
        && (
          (
            data.publishConflictResult == 'passed'
            && data.publishOverrideReason == ''
          )
          || (
            admin(companyId)
            && data.publishConflictResult == 'override'
            && data.publishOverrideReason.size() >= 8
          )
        )
        && data.lastPublishedAssignmentId == ''
        && data.publishedAt == null
        && data.publishedBy == ''
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'publishTotal',
          'publishCompleted',
          'publishToken',
          'publishConflictResult',
          'publishOverrideReason',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function validRosterPublishCompletionUpdate(companyId, rosterId) {
      let data = request.resource.data;
      return (
          admin(companyId)
          || (
            managerActor(companyId)
            && resource.data.ownerUid == request.auth.uid
            && resource.data.managerEmployeeId
              == member(companyId).data.employeeId
            && resource.data.scopeKind == 'manager'
          )
        )
        && data.id == rosterId
        && data.companyId == resource.data.companyId
        && data.ownerUid == resource.data.ownerUid
        && data.status == 'published'
        && resource.data.status == 'publishing'
        && resource.data.publishCompleted == resource.data.publishTotal
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'publishedAt',
          'publishedBy',
          'updatedAt',
          'updatedBy'
        ]);
    }

    match /nasna_users/{uid} {
      allow get: if signedIn()
        && (
          request.auth.uid == uid
          || (
            resource.data.activeCompanyId is string
            && admin(resource.data.activeCompanyId)
          )
        );

      allow list: if false;

      allow create: if signedIn()
        && validUserShape(uid)
        && (
          (
            request.auth.uid == uid
            && request.resource.data.email == request.auth.token.email
            && activeMemberAfter(request.resource.data.activeCompanyId)
          )
          || admin(request.resource.data.activeCompanyId)
        );

      allow update: if signedIn()
        && validUserShape(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (
          (
            request.auth.uid == uid
            && request.resource.data.status == resource.data.status
            && activeMemberAfter(request.resource.data.activeCompanyId)
          )
          || admin(resource.data.activeCompanyId)
        );

      allow delete: if false;
    }

    match /nasna_companies/{companyId} {
      allow get: if activeMember(companyId);
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && memberAfter(companyId, request.auth.uid).data.role == 'super_admin'
        && memberAfter(companyId, request.auth.uid).data.status == 'active';

      allow update: if superAdmin(companyId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in ['active', 'suspended'];

      allow delete: if false;

      match /members/{memberId} {
        allow read: if activeMember(companyId);

        allow create: if signedIn()
          && request.resource.data.uid == memberId
          && request.resource.data.companyId == companyId
          && request.resource.data.role in ['super_admin', 'hr_admin', 'manager', 'employee']
          && request.resource.data.status in ['active', 'disabled']
          && (
            (
              request.auth.uid == memberId
              && getAfter(companyPath(companyId)).data.ownerId == request.auth.uid
              && request.resource.data.role == 'super_admin'
              && request.resource.data.status == 'active'
            )
            || (
              admin(companyId)
              && (
                request.resource.data.role != 'super_admin'
                || superAdmin(companyId)
              )
            )
          );

        allow update: if (
            admin(companyId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.email == resource.data.email
            && request.resource.data.role in [
              'super_admin',
              'hr_admin',
              'manager',
              'employee'
            ]
            && request.resource.data.status in ['active', 'disabled']
            && (
              superAdmin(companyId)
              || (
                resource.data.role != 'super_admin'
                && request.resource.data.role != 'super_admin'
              )
            )
            && (
              memberId != get(companyPath(companyId)).data.ownerId
              || (
                request.resource.data.role == 'super_admin'
                && request.resource.data.status == 'active'
              )
            )
          )
          || validOwnDelegationMarkerUpdate(companyId, memberId);

        allow delete: if superAdmin(companyId)
          && memberId != get(companyPath(companyId)).data.ownerId;
      }

      match /branches/{branchId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validBranchShape(companyId, branchId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validBranchShape(companyId, branchId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nameEn',
            'nameAr',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /locations/{locationId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validLocationShape(companyId, locationId)
          && exists(branchPath(companyId, request.resource.data.branchId))
          && get(branchPath(companyId, request.resource.data.branchId)).data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
