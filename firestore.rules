                  rosterPath(companyId, resource.data.rosterId)
                ).data.revision
                && getAfter(
                  rosterPath(companyId, resource.data.rosterId)
                ).data.status == 'draft'
                && getAfter(
                  rosterPath(companyId, resource.data.rosterId)
                ).data.draftState == 'saving'
