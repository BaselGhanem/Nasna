rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(companyId, uid) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/members/$(uid);
    }

    function companyPath(companyId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId);
    }

    function branchPath(companyId, branchId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/branches/$(branchId);
    }

    function locationPath(companyId, locationId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/locations/$(locationId);
    }

    function departmentPath(companyId, departmentId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/departments/$(departmentId);
    }

    function teamPath(companyId, teamId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/teams/$(teamId);
    }

    function jobGradePath(companyId, gradeId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/jobGrades/$(gradeId);
    }

    function jobTitlePath(companyId, jobTitleId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/jobTitles/$(jobTitleId);
    }

    function positionPath(companyId, positionId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/positions/$(positionId);
    }

    function employeePath(companyId, employeeId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/employees/$(employeeId);
    }

    function employeeMovementPath(companyId, movementId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/employeeMovements/$(movementId);
    }

    function employeeDocumentPath(companyId, documentId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/employeeDocuments/$(documentId);
    }

    function timeSettingsPath(companyId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/timeSettings/current;
    }

    function timePolicyPath(companyId, policyId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/timePolicies/$(policyId);
    }

    function shiftTemplatePath(companyId, templateId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/shiftTemplates/$(templateId);
    }

    function holidayPath(companyId, holidayId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/holidays/$(holidayId);
    }

    function rosterPath(companyId, rosterId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/rosters/$(rosterId);
    }

    function shiftAssignmentPath(companyId, assignmentId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/shiftAssignments/$(assignmentId);
    }

    function scheduleLockPath(companyId, lockId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/scheduleLocks/$(lockId);
    }

    function requestTypePath(companyId, requestTypeId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/requestTypes/$(requestTypeId);
    }

    function workflowPath(companyId, workflowId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/workflowDefinitions/$(workflowId);
    }

    function workflowRequestPath(companyId, requestId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/requests/$(requestId);
    }

    function requestCounterPath(companyId, counterId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/requestCounters/$(counterId);
    }

    function delegationPath(companyId, delegationId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/delegations/$(delegationId);
    }

    function workflowRequestEventPath(companyId, requestId, eventId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/requests/$(requestId)/events/$(eventId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/nasna_users/$(uid);
    }

    function member(companyId) {
      return get(memberPath(companyId, request.auth.uid));
    }

    function memberAfter(companyId, uid) {
      return getAfter(memberPath(companyId, uid));
    }

    function activeMember(companyId) {
      return signedIn()
        && member(companyId).data.status == 'active';
    }

    function activeMemberAfter(companyId) {
      return signedIn()
        && memberAfter(companyId, request.auth.uid).data.status == 'active';
    }

    function roleIn(companyId, roles) {
      return signedIn()
        && member(companyId).data.status == 'active'
        && member(companyId).data.role in roles;
    }

    function admin(companyId) {
      return roleIn(companyId, ['super_admin', 'hr_admin']);
    }

    function superAdmin(companyId) {
      return roleIn(companyId, ['super_admin']);
    }

    function actorCreatedDocument(targetPath) {
      let afterData = getAfter(targetPath).data;
      return !exists(targetPath)
        && existsAfter(targetPath)
        && afterData.createdBy == request.auth.uid
        && afterData.updatedAt == request.time
        && (
          (
            afterData.keys().hasAny(['createdAt'])
            && afterData.createdAt == request.time
          )
          || (
            afterData.keys().hasAny(['joinedAt'])
            && afterData.joinedAt == request.time
          )
        );
    }

    function actorUpdatedDocument(targetPath) {
      return exists(targetPath)
        && existsAfter(targetPath)
        && getAfter(targetPath).data.updatedBy == request.auth.uid
        && getAfter(targetPath).data.updatedAt == request.time;
    }

    function actorChangedStatus(targetPath) {
      return actorUpdatedDocument(targetPath)
        && getAfter(targetPath).data.status != get(targetPath).data.status;
    }

    function auditMutationBacksAction(
      companyId,
      action,
      targetId
    ) {
      return (
          action == 'company.created'
          && targetId == companyId
          && !exists(companyPath(companyId))
          && existsAfter(companyPath(companyId))
          && getAfter(companyPath(companyId)).data.ownerId
            == request.auth.uid
          && getAfter(companyPath(companyId)).data.createdAt
            == request.time
          && memberAfter(companyId, request.auth.uid).data.role
            == 'super_admin'
          && memberAfter(companyId, request.auth.uid).data.status
            == 'active'
        )
        || (
          action == 'member.created'
          && actorCreatedDocument(memberPath(companyId, targetId))
        )
        || (
          action == 'member.role_changed'
          && actorUpdatedDocument(memberPath(companyId, targetId))
          && getAfter(memberPath(companyId, targetId)).data.role
            != get(memberPath(companyId, targetId)).data.role
        )
        || (
          action == 'member.status_changed'
          && actorChangedStatus(memberPath(companyId, targetId))
        )
        || (
          action == 'branch.created'
          && actorCreatedDocument(branchPath(companyId, targetId))
        )
        || (
          action == 'branch.updated'
          && actorUpdatedDocument(branchPath(companyId, targetId))
        )
        || (
          action == 'branch.status_changed'
          && actorChangedStatus(branchPath(companyId, targetId))
        )
        || (
          action == 'location.created'
          && actorCreatedDocument(locationPath(companyId, targetId))
        )
        || (
          action == 'location.updated'
          && actorUpdatedDocument(locationPath(companyId, targetId))
        )
        || (
          action == 'location.status_changed'
          && actorChangedStatus(locationPath(companyId, targetId))
        )
        || (
          action == 'department.created'
          && actorCreatedDocument(departmentPath(companyId, targetId))
        )
        || (
          action == 'department.updated'
          && actorUpdatedDocument(departmentPath(companyId, targetId))
        )
        || (
          action == 'department.status_changed'
          && actorChangedStatus(departmentPath(companyId, targetId))
        )
        || (
          action == 'team.created'
          && actorCreatedDocument(teamPath(companyId, targetId))
        )
        || (
          action == 'team.updated'
          && actorUpdatedDocument(teamPath(companyId, targetId))
        )
        || (
          action == 'team.status_changed'
          && actorChangedStatus(teamPath(companyId, targetId))
        )
        || (
          action == 'grade.created'
          && actorCreatedDocument(jobGradePath(companyId, targetId))
        )
        || (
          action == 'grade.updated'
          && actorUpdatedDocument(jobGradePath(companyId, targetId))
        )
        || (
          action == 'grade.status_changed'
          && actorChangedStatus(jobGradePath(companyId, targetId))
        )
        || (
          action == 'title.created'
          && actorCreatedDocument(jobTitlePath(companyId, targetId))
        )
        || (
          action == 'title.updated'
          && actorUpdatedDocument(jobTitlePath(companyId, targetId))
        )
        || (
          action == 'title.status_changed'
          && actorChangedStatus(jobTitlePath(companyId, targetId))
        )
        || (
          action == 'position.created'
          && actorCreatedDocument(positionPath(companyId, targetId))
        )
        || (
          action == 'position.updated'
          && actorUpdatedDocument(positionPath(companyId, targetId))
        )
        || (
          action == 'position.status_changed'
          && actorChangedStatus(positionPath(companyId, targetId))
        )
        || (
          action in ['employee.created', 'employee.imported']
          && actorCreatedDocument(employeePath(companyId, targetId))
        )
        || (
          action == 'employee.updated'
          && actorUpdatedDocument(employeePath(companyId, targetId))
        )
        || (
          action == 'employee_document.created'
          && actorCreatedDocument(
            employeeDocumentPath(companyId, targetId)
          )
        )
        || (
          action == 'employee_document.updated'
          && actorUpdatedDocument(
            employeeDocumentPath(companyId, targetId)
          )
        )
        || (
          action == 'employee_movement.applied'
          && !exists(employeeMovementPath(companyId, targetId))
          && existsAfter(employeeMovementPath(companyId, targetId))
          && getAfter(
            employeeMovementPath(companyId, targetId)
          ).data.createdBy == request.auth.uid
          && getAfter(
            employeeMovementPath(companyId, targetId)
          ).data.createdAt == request.time
        )
        || (
          action == 'time_policy.published'
          && actorCreatedDocument(timePolicyPath(companyId, targetId))
        )
        || (
          action == 'shift_template.created'
          && actorCreatedDocument(shiftTemplatePath(companyId, targetId))
        )
        || (
          action == 'shift_template.updated'
          && actorUpdatedDocument(shiftTemplatePath(companyId, targetId))
        )
        || (
          action == 'holiday.created'
          && actorCreatedDocument(holidayPath(companyId, targetId))
        )
        || (
          action == 'holiday.updated'
          && actorUpdatedDocument(holidayPath(companyId, targetId))
        )
        || (
          action == 'holiday_calendar.confirmed'
          && targetId == 'current'
          && actorUpdatedDocument(timeSettingsPath(companyId))
        )
        || (
          action == 'roster.created'
          && actorCreatedDocument(rosterPath(companyId, targetId))
        )
        || (
          action == 'roster.updated'
          && actorUpdatedDocument(rosterPath(companyId, targetId))
        )
        || (
          action == 'roster.published'
          && actorChangedStatus(rosterPath(companyId, targetId))
          && getAfter(rosterPath(companyId, targetId)).data.status
            == 'published'
        )
        || (
          action == 'shift_requests.activated'
          && targetId == 'current'
          && actorUpdatedDocument(timeSettingsPath(companyId))
          && getAfter(timeSettingsPath(companyId)).data.requestServicesEnabled
            == true
        );
    }

    function requestCounterBackedByCreate(companyId) {
      let createdRequest = getAfter(
        workflowRequestPath(
          companyId,
          request.resource.data.lastRequestId
        )
      ).data;
      return request.resource.data.keys().hasOnly([
          'companyId',
          'value',
          'lastRequestId',
          'lastRequestNumber',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.lastRequestId is string
        && request.resource.data.lastRequestId.size() > 0
        && request.resource.data.lastRequestId.size() <= 80
        && request.resource.data.lastRequestNumber is string
        && request.resource.data.lastRequestNumber.matches(
          '^REQ-([A-Z0-9]{2,8}-)?[0-9]{4}-[A-Z0-9]{5,20}$'
        )
        && createdRequest.requestNumber
          == request.resource.data.lastRequestNumber
        && createdRequest.sequence == request.resource.data.value
        && createdRequest.requesterUid == request.auth.uid
        && createdRequest.createdAt == request.time
        && createdRequest.createdBy == request.auth.uid;
    }

    function activeDelegationFor(
      companyId,
      delegationId,
      delegatorUid,
      delegateUid
    ) {
      return delegationId is string
        && delegationId.size() > 0
        && delegationId.size() <= 80
        && exists(delegationPath(companyId, delegationId))
        && get(
          delegationPath(companyId, delegationId)
        ).data.delegatorUid == delegatorUid
        && get(
          delegationPath(companyId, delegationId)
        ).data.delegateUid == delegateUid
        && get(
          delegationPath(companyId, delegationId)
        ).data.status == 'active'
        && get(
          delegationPath(companyId, delegationId)
        ).data.startAt <= request.time
        && get(
          delegationPath(companyId, delegationId)
        ).data.endAt > request.time;
    }

    function activeDelegationAfterFor(
      companyId,
      delegationId,
      delegatorUid,
      delegateUid
    ) {
      return delegationId is string
        && delegationId.size() > 0
        && delegationId.size() <= 80
        && existsAfter(delegationPath(companyId, delegationId))
        && getAfter(
          delegationPath(companyId, delegationId)
        ).data.delegatorUid == delegatorUid
        && getAfter(
          delegationPath(companyId, delegationId)
        ).data.delegateUid == delegateUid
        && getAfter(
          delegationPath(companyId, delegationId)
        ).data.status == 'active'
        && getAfter(
          delegationPath(companyId, delegationId)
        ).data.startAt <= request.time
        && getAfter(
          delegationPath(companyId, delegationId)
        ).data.endAt > request.time;
    }

    function validOwnDelegationMarkerUpdate(companyId, memberId) {
      let markerKeys = [
        'activeDelegationId',
        'activeDelegateUid',
        'activeDelegationStartAt',
        'activeDelegationEndAt',
        'updatedAt',
        'updatedBy'
      ];
      return activeMember(companyId)
        && memberId == request.auth.uid
        && managerActor(companyId)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly(markerKeys)
        && (
          (
            (
              !resource.data.keys().hasAny(['activeDelegationId'])
              || resource.data.activeDelegationId == ''
            )
            && request.resource.data.activeDelegationStartAt is timestamp
            && request.resource.data.activeDelegationEndAt is timestamp
            && activeDelegationAfterFor(
              companyId,
              request.resource.data.activeDelegationId,
              request.auth.uid,
              request.resource.data.activeDelegateUid
            )
            && request.resource.data.activeDelegationStartAt
              == getAfter(
                delegationPath(
                  companyId,
                  request.resource.data.activeDelegationId
                )
              ).data.startAt
            && request.resource.data.activeDelegationEndAt
              == getAfter(
                delegationPath(
                  companyId,
                  request.resource.data.activeDelegationId
                )
              ).data.endAt
          )
          || (
            resource.data.keys().hasAny(['activeDelegationId'])
            && resource.data.activeDelegationId != ''
            && request.resource.data.activeDelegationId == ''
            && request.resource.data.activeDelegateUid == ''
            && request.resource.data.activeDelegationStartAt == null
            && request.resource.data.activeDelegationEndAt == null
            && existsAfter(
              delegationPath(
                companyId,
                resource.data.activeDelegationId
              )
            )
            && getAfter(
              delegationPath(
                companyId,
                resource.data.activeDelegationId
              )
            ).data.delegatorUid == request.auth.uid
            && getAfter(
              delegationPath(
                companyId,
                resource.data.activeDelegationId
              )
            ).data.status == 'cancelled'
          )
        );
    }

    function managerActor(companyId) {
      return signedIn()
        && member(companyId).data.status == 'active'
        && (
          member(companyId).data.role == 'manager'
          || member(companyId).data.isManager == true
        );
    }

    function requestTerminal(status) {
      return status in [
        'COMPLETED',
        'REJECTED',
        'WITHDRAWN',
        'CANCELLED'
      ];
    }

    function requestOwner(data) {
      return signedIn() && data.requesterUid == request.auth.uid;
    }

    function requestAssigned(data) {
      return signedIn()
        && data.currentAssigneeIds is list
        && data.currentAssigneeIds.hasAny([request.auth.uid]);
    }

    function requestLineManager(companyId, data) {
      return activeMember(companyId)
        && data.confidentiality == 'normal'
        && member(companyId).data.employeeId is string
        && member(companyId).data.employeeId == data.managerEmployeeId;
    }

    function canReadWorkflowRequest(companyId, data) {
      return activeMember(companyId)
        && (
          member(companyId).data.role in ['super_admin', 'hr_admin']
          || requestOwner(data)
          || requestAssigned(data)
          || (
            data.confidentiality == 'normal'
            && member(companyId).data.employeeId is string
            && member(companyId).data.employeeId == data.managerEmployeeId
          )
        );
    }

    function validRequestTypeShape(companyId, requestTypeId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'version',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'category',
          'confidentiality',
          'subjectMode',
          'initialResolver',
          'formSchema',
          'workflowId',
          'status',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'version',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'category',
          'confidentiality',
          'subjectMode',
          'initialResolver',
          'formSchema',
          'workflowId',
          'status',
          'createdAt',
          'createdBy',
          'retiredAt',
          'retiredBy'
        ])
        && request.resource.data.id == requestTypeId
        && request.resource.data.companyId == companyId
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[a-z][a-z0-9_]{2,39}$')
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.nameEn is string
        && request.resource.data.nameEn.size() > 0
        && request.resource.data.nameEn.size() <= 120
        && request.resource.data.nameAr is string
        && request.resource.data.nameAr.size() > 0
        && request.resource.data.nameAr.size() <= 120
        && request.resource.data.descriptionEn is string
        && request.resource.data.descriptionEn.size() <= 500
        && request.resource.data.descriptionAr is string
        && request.resource.data.descriptionAr.size() <= 500
        && request.resource.data.category in [
          'general',
          'personal_data',
          'documents',
          'confidential',
          'team',
          'correction',
          'custom'
        ]
        && request.resource.data.confidentiality in ['normal', 'restricted']
        && request.resource.data.subjectMode in ['self', 'direct_report']
        && request.resource.data.initialResolver in ['direct_manager', 'hr']
        && request.resource.data.formSchema is list
        && request.resource.data.formSchema.size() > 0
        && request.resource.data.formSchema.size() <= 30
        && request.resource.data.workflowId is string
        && request.resource.data.workflowId.size() > 0
        && request.resource.data.workflowId.size() <= 100
        && request.resource.data.status in ['published', 'retired']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string;
    }

    function validWorkflowStep(
      step,
      expectedIndex,
      expectedType,
      expectedResolver,
      expectedMode
    ) {
      return step is map
        && step.keys().hasAll([
          'index',
          'type',
          'resolver',
          'mode',
          'slaHours',
          'nameEn',
          'nameAr'
        ])
        && step.keys().hasOnly([
          'index',
          'type',
          'resolver',
          'mode',
          'slaHours',
          'nameEn',
          'nameAr'
        ])
        && step.index == expectedIndex
        && step.type == expectedType
        && step.resolver == expectedResolver
        && step.mode == expectedMode
        && step.slaHours is int
        && step.slaHours >= 1
        && step.slaHours <= 8760
        && step.nameEn is string
        && step.nameEn.size() > 0
        && step.nameEn.size() <= 120
        && step.nameAr is string
        && step.nameAr.size() > 0
        && step.nameAr.size() <= 120;
    }

    function validWorkflowShape(companyId, workflowId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'requestTypeCode',
          'version',
          'steps',
          'slaHours',
          'status',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'requestTypeCode',
          'version',
          'steps',
          'slaHours',
          'status',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.id == workflowId
        && request.resource.data.companyId == companyId
        && request.resource.data.requestTypeCode is string
        && request.resource.data.requestTypeCode.matches('^[a-z][a-z0-9_]{2,39}$')
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.steps is list
        && request.resource.data.steps.size() > 0
        && request.resource.data.steps.size() <= 2
        && request.resource.data.slaHours is int
        && request.resource.data.slaHours >= 1
        && request.resource.data.slaHours <= 8760
        && (
          (
            request.resource.data.steps.size() == 1
            && validWorkflowStep(
              request.resource.data.steps[0],
              0,
              'fulfillment',
              'hr',
              'parallel_any'
            )
            && request.resource.data.slaHours
              == request.resource.data.steps[0].slaHours
          )
          || (
            request.resource.data.steps.size() == 2
            && validWorkflowStep(
              request.resource.data.steps[0],
              0,
              'approval',
              'direct_manager',
              'sequential'
            )
            && validWorkflowStep(
              request.resource.data.steps[1],
              1,
              'fulfillment',
              'hr',
              'parallel_any'
            )
            && request.resource.data.slaHours
              == request.resource.data.steps[0].slaHours
                + request.resource.data.steps[1].slaHours
          )
        )
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string;
    }

    function validWorkflowDraftShape(companyId, draftId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'category',
          'confidentiality',
          'subjectMode',
          'initialResolver',
          'slaHours',
          'formSchema',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'category',
          'confidentiality',
          'subjectMode',
          'initialResolver',
          'slaHours',
          'formSchema',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == draftId
        && request.resource.data.companyId == companyId
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[a-z][a-z0-9_]{2,39}$')
        && request.resource.data.nameEn is string
        && request.resource.data.nameEn.size() > 0
        && request.resource.data.nameEn.size() <= 120
        && request.resource.data.nameAr is string
        && request.resource.data.nameAr.size() > 0
        && request.resource.data.nameAr.size() <= 120
        && request.resource.data.descriptionEn is string
        && request.resource.data.descriptionEn.size() <= 500
        && request.resource.data.descriptionAr is string
        && request.resource.data.descriptionAr.size() <= 500
        && request.resource.data.category in [
          'general',
          'personal_data',
          'documents',
          'confidential',
          'team',
          'correction',
          'custom'
        ]
        && request.resource.data.confidentiality in ['normal', 'restricted']
        && request.resource.data.subjectMode in ['self', 'direct_report']
        && request.resource.data.initialResolver in ['direct_manager', 'hr']
        && (
          request.resource.data.confidentiality == 'normal'
          || request.resource.data.initialResolver == 'hr'
        )
        && request.resource.data.slaHours is int
        && request.resource.data.slaHours >= 1
        && request.resource.data.slaHours <= 8760
        && request.resource.data.formSchema is list
        && request.resource.data.formSchema.size() > 0
        && request.resource.data.formSchema.size() <= 30
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validWorkflowRequestShape(companyId, workflowRequestId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id',
          'companyId',
          'requestNumber',
          'typeId',
          'typeCode',
          'typeVersion',
          'workflowId',
          'requesterUid',
          'requesterEmployeeId',
          'requesterName',
          'subjectEmployeeId',
          'subjectName',
          'managerEmployeeId',
          'status',
          'currentStep',
          'currentStepType',
          'currentAssigneeIds',
          'routeKind',
          'payload',
          'confidentiality',
          'priority',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'revision',
          'previousStatus',
          'previousAssigneeIds',
          'delegationId',
          'originalAssigneeIds',
          'dueAt',
          'submittedAt',
          'lastEventId',
          'outcome',
          'fulfillmentRef',
          'completedAt',
          'withdrawnAt'
        ])
        && data.id == workflowRequestId
        && data.companyId == companyId
        && data.requestNumber.matches(
          '^REQ-([A-Z0-9]{2,8}-)?[0-9]{4}-[A-Z0-9]{5,20}$'
        )
        && data.typeVersion is int
        && data.typeVersion >= 1
        && (
          !data.keys().hasAny(['sequence'])
          || (
            data.sequence is int
            && data.sequence >= 1
            && data.sequence <= 999999999
          )
        )
        && data.requesterName.size() > 0
        && data.requesterName.size() <= 140
        && data.subjectName.size() > 0
        && data.subjectName.size() <= 140
        && data.currentAssigneeIds is list
        && data.currentAssigneeIds.size() <= 20
        && data.previousAssigneeIds is list
        && data.previousAssigneeIds.size() <= 20
        && data.delegationId.size() <= 80
        && data.originalAssigneeIds is list
        && data.originalAssigneeIds.size() <= 20
        && data.payload is map
        && data.priority in ['normal', 'high', 'urgent']
        && (
          !data.keys().hasAny(['slaRemainingHours'])
          || (
            data.slaRemainingHours is number
            && data.slaRemainingHours >= 0
            && data.slaRemainingHours <= 8760
          )
        )
        && data.lastEventId.size() > 0
        && data.lastEventId.size() <= 80
        && (data.dueAt == null || data.dueAt is timestamp)
        && data.outcome is map
        && data.fulfillmentRef is map;
    }

    function validRequestSubjectData(
      companyId,
      requestType,
      requesterEmployeeId,
      requesterEmployee,
      data
    ) {
      return requesterEmployeeId is string
        && requesterEmployeeId == data.requesterEmployeeId
        && requesterEmployee.authUid == request.auth.uid
        && (
          (
            requestType.subjectMode == 'self'
            && data.subjectEmployeeId == requesterEmployeeId
          )
          || (
            requestType.subjectMode == 'direct_report'
            && get(
              employeePath(companyId, data.subjectEmployeeId)
            ).data.managerEmployeeId == requesterEmployeeId
          )
        );
    }

    function validInitialRequestRouteData(
      companyId,
      requestType,
      requesterEmployee,
      data
    ) {
      let managerEmployeePath = employeePath(
        companyId,
        requesterEmployee.managerEmployeeId
      );
      let hasManagerRecord = requesterEmployee.managerEmployeeId != ''
        && exists(managerEmployeePath);
      let managerUid = hasManagerRecord
        ? get(managerEmployeePath).data.authUid
        : '';
      let managerMemberPath = memberPath(companyId, managerUid);
      let managerMember = hasManagerRecord
        && managerUid != request.auth.uid
        && exists(managerMemberPath)
        ? get(managerMemberPath).data
        : null;
      let hasValidManager = managerMember != null
        && managerMember.status == 'active';
      let managerHasDelegationMarker = hasValidManager
        && managerMember.keys().hasAll([
          'activeDelegationId',
          'activeDelegateUid',
          'activeDelegationStartAt',
          'activeDelegationEndAt'
        ]);
      let managerDelegationId = managerHasDelegationMarker
        ? managerMember.activeDelegationId
        : '';
      let managerDelegateUid = managerHasDelegationMarker
        ? managerMember.activeDelegateUid
        : '';
      let hasActiveDelegation = managerHasDelegationMarker
        && activeDelegationFor(
          companyId,
          managerDelegationId,
          managerUid,
          managerDelegateUid
        );
      return (
          data.status == 'DRAFT'
          && data.routeKind == ''
          && data.currentAssigneeIds.size() == 0
          && data.submittedAt == null
          && data.delegationId == ''
          && data.originalAssigneeIds.size() == 0
        )
        || (
          data.status in [
            'SUBMITTED',
            'PENDING_APPROVAL',
            'PENDING_FULFILLMENT'
          ]
          && data.submittedAt == request.time
          && data.currentAssigneeIds.size() > 0
          && !data.currentAssigneeIds.hasAny([
            request.auth.uid
          ])
          && (
            (
              requestType.initialResolver == 'direct_manager'
              && hasValidManager
              && data.routeKind == 'manager'
              && data.managerEmployeeId
                == requesterEmployee.managerEmployeeId
              && data.status == 'PENDING_APPROVAL'
              && (
                (
                  !hasActiveDelegation
                  && data.currentAssigneeIds[0]
                    == managerUid
                  && data.delegationId == ''
                  && data.originalAssigneeIds.size() == 0
                )
                || (
                  hasActiveDelegation
                  && data.currentAssigneeIds[0]
                    == managerDelegateUid
                  && data.delegationId
                    == managerDelegationId
                  && data.originalAssigneeIds
                    == [managerUid]
                )
              )
            )
            || (
              (
                requestType.initialResolver == 'hr'
                || !hasValidManager
              )
              && data.routeKind == 'hr'
              && data.currentAssigneeIds.size() > 0
              && get(
                memberPath(
                  companyId,
                  data.currentAssigneeIds[0]
                )
              ).data.role in ['super_admin', 'hr_admin']
              && data.status == 'PENDING_FULFILLMENT'
              && data.delegationId == ''
              && data.originalAssigneeIds.size() == 0
            )
          )
        );
    }

    function validInitialRequestRoute(companyId) {
      let requestType = get(
        requestTypePath(companyId, request.resource.data.typeId)
      ).data;
      let requesterEmployee = get(
        employeePath(companyId, request.resource.data.requesterEmployeeId)
      ).data;
      return validInitialRequestRouteData(
        companyId,
        requestType,
        requesterEmployee,
        request.resource.data
      );
    }

    function validShiftChangeRequestPayload(companyId, requestType) {
      let data = request.resource.data;
      let payload = data.payload;
      let settings = get(timeSettingsPath(companyId)).data;
      let assignment = get(
        shiftAssignmentPath(companyId, payload.assignmentId)
      ).data;
      let requestedTemplate = get(
        shiftTemplatePath(
          companyId,
          payload.requestedShiftTemplateId
        )
      ).data;
      return requestType.code == 'shift_change'
        && settings.requestServicesEnabled == true
        && settings.requestTypeIds.hasAny([data.typeId])
        && payload.keys().hasOnly([
          'assignmentId',
          'workDate',
          'requestedShiftTemplateId',
          'reason'
        ])
        && payload.assignmentId is string
        && payload.assignmentId.size() > 0
        && payload.assignmentId.size() <= 180
        && validIsoDate(payload.workDate)
        && payload.reason is string
        && payload.reason.size() > 0
        && payload.reason.size() <= 2000
        && assignment.status == 'published'
        && assignment.employeeAuthUid == data.requesterUid
        && assignment.employeeId == data.subjectEmployeeId
        && assignment.workDate == payload.workDate
        && payload.requestedShiftTemplateId is string
        && requestedTemplate.status == 'active'
        && payload.requestedShiftTemplateId != assignment.templateId;
    }

    function validShiftSwapRequestPayload(companyId, requestType) {
      let data = request.resource.data;
      let payload = data.payload;
      let settings = get(timeSettingsPath(companyId)).data;
      let assignment = get(
        shiftAssignmentPath(companyId, payload.assignmentId)
      ).data;
      let colleagueAssignment = get(
        shiftAssignmentPath(
          companyId,
          payload.colleagueAssignmentId
        )
      ).data;
      return requestType.code == 'shift_swap'
        && settings.requestServicesEnabled == true
        && settings.requestTypeIds.hasAny([data.typeId])
        && payload.keys().hasOnly([
          'assignmentId',
          'workDate',
          'colleagueEmployeeCode',
          'colleagueAssignmentId',
          'reason'
        ])
        && payload.assignmentId is string
        && payload.assignmentId.size() > 0
        && payload.assignmentId.size() <= 180
        && validIsoDate(payload.workDate)
        && payload.reason is string
        && payload.reason.size() > 0
        && payload.reason.size() <= 2000
        && assignment.status == 'published'
        && assignment.employeeAuthUid == data.requesterUid
        && assignment.employeeId == data.subjectEmployeeId
        && assignment.workDate == payload.workDate
        && payload.colleagueEmployeeCode is string
        && payload.colleagueAssignmentId is string
        && payload.colleagueAssignmentId != payload.assignmentId
        && colleagueAssignment.status == 'published'
        && colleagueAssignment.employeeId
          == payload.colleagueEmployeeCode
        && colleagueAssignment.employeeId != data.subjectEmployeeId
        && colleagueAssignment.workDate == payload.workDate
        && colleagueAssignment.managerEmployeeId
          == assignment.managerEmployeeId;
    }

    function validStage11RequestPayload(companyId, requestType) {
      return !(requestType.code in ['shift_change', 'shift_swap'])
        || (
          requestType.code == 'shift_change'
          && validShiftChangeRequestPayload(companyId, requestType)
        )
        || (
          requestType.code == 'shift_swap'
          && validShiftSwapRequestPayload(companyId, requestType)
        );
    }

    function validWorkflowRequestCreate(companyId, workflowRequestId) {
      let data = request.resource.data;
      let requesterMembership = member(companyId).data;
      let requestType = get(
        requestTypePath(companyId, data.typeId)
      ).data;
      let requesterEmployeeId = requesterMembership.employeeId;
      let requesterEmployee = get(
        employeePath(companyId, requesterEmployeeId)
      ).data;
      let counterAfter = getAfter(
        requestCounterPath(companyId, 'requests')
      ).data;
      let eventAfter = getAfter(
        workflowRequestEventPath(
          companyId,
          workflowRequestId,
          data.lastEventId
        )
      ).data;
      return signedIn()
        && requesterMembership.status == 'active'
        && validWorkflowRequestShape(companyId, workflowRequestId)
        && requestType.status == 'published'
        && requestType.code == data.typeCode
        && requestType.version == data.typeVersion
        && requestType.workflowId == data.workflowId
        && requestType.confidentiality
          == data.confidentiality
        && validStage11RequestPayload(companyId, requestType)
        && validRequestSubjectData(
          companyId,
          requestType,
          requesterEmployeeId,
          requesterEmployee,
          data
        )
        && validInitialRequestRouteData(
          companyId,
          requestType,
          requesterEmployee,
          data
        )
        && data.requesterUid == request.auth.uid
        && data.createdAt == request.time
        && data.createdBy == request.auth.uid
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.revision == 0
        && data.currentStep == 0
        && counterAfter.lastRequestId == workflowRequestId
        && counterAfter.lastRequestNumber
          == data.requestNumber
        && data.sequence == counterAfter.value
        && counterAfter.updatedBy == request.auth.uid
        && eventAfter.actorUid == request.auth.uid
        && data.previousStatus == ''
        && data.previousAssigneeIds.size() == 0
        && data.completedAt == null
        && data.withdrawnAt == null;
    }

    function validAppliedShiftRecord(
      workflowRequestId,
      workDate,
      replacementId,
      previous,
      replacement,
      lock
    ) {
      return replacement.status == 'published'
        && replacement.sourceRequestId == workflowRequestId
        && replacement.previousAssignmentId == previous.id
        && replacement.employeeId == previous.employeeId
        && replacement.employeeAuthUid == previous.employeeAuthUid
        && replacement.managerEmployeeId == previous.managerEmployeeId
        && replacement.branchId == previous.branchId
        && replacement.workDate == workDate
        && replacement.version == previous.version + 1
        && previous.status == 'superseded'
        && previous.supersededBy == replacementId
        && lock.currentAssignmentId == replacementId
        && lock.version == replacement.version;
    }

    function validCompletedShiftChange(
      companyId,
      workflowRequestId,
      data
    ) {
      let replacement = get(
        shiftAssignmentPath(companyId, data.fulfillmentRef.id)
      ).data;
      let previous = get(
        shiftAssignmentPath(companyId, data.payload.assignmentId)
      ).data;
      let lock = get(
        scheduleLockPath(
          companyId,
          data.subjectEmployeeId + '__' + data.payload.workDate
        )
      ).data;
      return data.fulfillmentRef.kind == 'shift_change'
        && data.fulfillmentRef.requestId == workflowRequestId
        && data.fulfillmentRef.colleagueId == ''
        && validAppliedShiftRecord(
          workflowRequestId,
          data.payload.workDate,
          data.fulfillmentRef.id,
          previous,
          replacement,
          lock
        )
        && replacement.employeeId == data.subjectEmployeeId
        && replacement.employeeAuthUid == data.requesterUid
        && replacement.templateId
          == data.payload.requestedShiftTemplateId
        && replacement.locationId == previous.locationId;
    }

    function validCompletedShiftSwap(
      companyId,
      workflowRequestId,
      data
    ) {
      let firstReplacement = get(
        shiftAssignmentPath(companyId, data.fulfillmentRef.id)
      ).data;
      let secondReplacement = get(
        shiftAssignmentPath(companyId, data.fulfillmentRef.colleagueId)
      ).data;
      let firstPrevious = get(
        shiftAssignmentPath(companyId, data.payload.assignmentId)
      ).data;
      let secondPrevious = get(
        shiftAssignmentPath(
          companyId,
          data.payload.colleagueAssignmentId
        )
      ).data;
      let firstLock = get(
        scheduleLockPath(
          companyId,
          data.subjectEmployeeId + '__' + data.payload.workDate
        )
      ).data;
      let secondLock = get(
        scheduleLockPath(
          companyId,
          data.payload.colleagueEmployeeCode
            + '__' + data.payload.workDate
        )
      ).data;
      return data.fulfillmentRef.kind == 'shift_swap'
        && data.fulfillmentRef.requestId == workflowRequestId
        && data.fulfillmentRef.id
          != data.fulfillmentRef.colleagueId
        && validAppliedShiftRecord(
          workflowRequestId,
          data.payload.workDate,
          data.fulfillmentRef.id,
          firstPrevious,
          firstReplacement,
          firstLock
        )
        && validAppliedShiftRecord(
          workflowRequestId,
          data.payload.workDate,
          data.fulfillmentRef.colleagueId,
          secondPrevious,
          secondReplacement,
          secondLock
        )
        && firstReplacement.employeeId == data.subjectEmployeeId
        && firstReplacement.employeeAuthUid == data.requesterUid
        && secondReplacement.employeeId
          == data.payload.colleagueEmployeeCode
        && firstReplacement.templateId == secondPrevious.templateId
        && firstReplacement.locationId == secondPrevious.locationId
        && secondReplacement.templateId == firstPrevious.templateId
        && secondReplacement.locationId == firstPrevious.locationId;
    }

    function validCompletedShiftRequest(
      companyId,
      workflowRequestId,
      data
    ) {
      return (
          data.typeCode == 'shift_change'
          && validCompletedShiftChange(
            companyId,
            workflowRequestId,
            data
          )
        )
        || (
          data.typeCode == 'shift_swap'
          && validCompletedShiftSwap(
            companyId,
            workflowRequestId,
            data
          )
        );
    }

    function validStage11CompletionUpdate(
      companyId,
      workflowRequestId
    ) {
      let data = request.resource.data;
      let previous = resource.data;
      let eventAfter = getAfter(
        workflowRequestEventPath(
          companyId,
          workflowRequestId,
          data.lastEventId
        )
      ).data;
      return admin(companyId)
        && previous.typeCode in ['shift_change', 'shift_swap']
        && previous.status == 'PENDING_FULFILLMENT'
        && previous.currentAssigneeIds.hasAny([request.auth.uid])
        && previous.requesterUid != request.auth.uid
        && data.status == 'COMPLETED'
        && data.currentAssigneeIds.size() == 0
        && data.payload == previous.payload
        && data.outcome.code == 'fulfilled'
        && data.outcome.note is string
        && data.outcome.note.size() <= 2000
        && data.completedAt == request.time
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.revision == previous.revision + 1
        && data.lastEventId != previous.lastEventId
        && data.diff(previous).affectedKeys().hasOnly([
          'status',
          'currentAssigneeIds',
          'outcome',
          'fulfillmentRef',
          'completedAt',
          'updatedAt',
          'updatedBy',
          'revision',
          'lastEventId'
        ])
        && validCompletedShiftRequest(
          companyId,
          workflowRequestId,
          data
        )
        && eventAfter.id == data.lastEventId
        && eventAfter.companyId == companyId
        && eventAfter.requestId == workflowRequestId
        && eventAfter.actorUid == request.auth.uid
        && eventAfter.type == 'FULFILLED'
        && eventAfter.payload.fulfillmentRef == data.fulfillmentRef
        && eventAfter.createdAt == request.time;
    }

    function validStage11FulfillmentTaskUpdate(
      companyId,
      workflowRequestId,
      taskId
    ) {
      let data = request.resource.data;
      let completedRequest = get(
        workflowRequestPath(companyId, workflowRequestId)
      ).data;
      return admin(companyId)
        && completedRequest.typeCode in ['shift_change', 'shift_swap']
        && completedRequest.status == 'COMPLETED'
        && completedRequest.currentAssigneeIds.size() == 0
        && completedRequest.fulfillmentRef.kind
          == completedRequest.typeCode
        && completedRequest.fulfillmentRef.requestId
          == workflowRequestId
        && resource.data.id == taskId
        && resource.data.status == 'PENDING'
        && resource.data.stepType == 'fulfillment'
        && data.status in ['APPROVED', 'CANCELLED']
        && (
          (
            data.status == 'APPROVED'
            && resource.data.assigneeUid == request.auth.uid
            && data.decision == 'approve'
          )
          || (
            data.status == 'CANCELLED'
            && data.decision == 'cancel'
          )
        )
        && data.note is string
        && data.note.size() <= 2000
        && data.actedAt == request.time
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'decision',
          'note',
          'actedAt',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function validStage11FulfilledEventCreate(
      companyId,
      workflowRequestId,
      eventId
    ) {
      let data = request.resource.data;
      let requestBefore = get(
        workflowRequestPath(companyId, workflowRequestId)
      ).data;
      let requestAfter = getAfter(
        workflowRequestPath(companyId, workflowRequestId)
      ).data;
      return admin(companyId)
        && requestBefore.typeCode in ['shift_change', 'shift_swap']
        && requestBefore.status == 'PENDING_FULFILLMENT'
        && requestBefore.currentAssigneeIds.hasAny([request.auth.uid])
        && requestAfter.status == 'COMPLETED'
        && requestAfter.lastEventId == eventId
        && requestAfter.updatedAt == request.time
        && requestAfter.updatedBy == request.auth.uid
        && data.keys().hasAll([
          'id',
          'companyId',
          'requestId',
          'actorUid',
          'actorName',
          'actorRole',
          'type',
          'message',
          'payload',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'companyId',
          'requestId',
          'actorUid',
          'actorName',
          'actorRole',
          'type',
          'message',
          'payload',
          'createdAt'
        ])
        && data.id == eventId
        && data.companyId == companyId
        && data.requestId == workflowRequestId
        && data.actorUid == request.auth.uid
        && data.actorName is string
        && data.actorName.size() > 0
        && data.actorName.size() <= 160
        && data.actorRole in ['super_admin', 'hr_admin']
        && data.type == 'FULFILLED'
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 2000
        && data.payload.fulfillmentRef
          == requestAfter.fulfillmentRef
        && data.createdAt == request.time;
    }

    function validWorkflowRequestUpdate(companyId, workflowRequestId) {
      let data = request.resource.data;
      let previous = resource.data;
      let requestType = get(
        requestTypePath(companyId, data.typeId)
      ).data;
      let eventAfter = getAfter(
        workflowRequestEventPath(
          companyId,
          workflowRequestId,
          data.lastEventId
        )
      ).data;
      return data.id == previous.id
        && (
          data.payload == previous.payload
          || validStage11RequestPayload(companyId, requestType)
        )
        && data.companyId == previous.companyId
        && data.requestNumber == previous.requestNumber
        && (
          (
            !previous.keys().hasAny(['sequence'])
            && !data.keys().hasAny(['sequence'])
          )
          || (
            previous.keys().hasAny(['sequence'])
            && data.sequence == previous.sequence
          )
        )
        && data.typeId == previous.typeId
        && data.typeCode == previous.typeCode
        && data.typeVersion == previous.typeVersion
        && data.workflowId == previous.workflowId
        && data.requesterUid == previous.requesterUid
        && data.requesterEmployeeId == previous.requesterEmployeeId
        && data.subjectEmployeeId == previous.subjectEmployeeId
        && data.managerEmployeeId == previous.managerEmployeeId
        && data.confidentiality == previous.confidentiality
        && data.createdAt == previous.createdAt
        && data.createdBy == previous.createdBy
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.revision == previous.revision + 1
        && data.lastEventId != previous.lastEventId
        && eventAfter.actorUid == request.auth.uid
        && !requestTerminal(previous.status)
        && (
          !(data.typeCode in ['shift_change', 'shift_swap'])
          || data.status != 'COMPLETED'
          || validCompletedShiftRequest(
            companyId,
            workflowRequestId,
            data
          )
        );
    }

    function validWorkflowTaskCreate(
      companyId,
      workflowRequestId,
      taskId
    ) {
      let task = request.resource.data;
      let requestAfter = getAfter(
        workflowRequestPath(companyId, workflowRequestId)
      ).data;
      return activeMember(companyId)
        && requestAfter.updatedBy == request.auth.uid
        && requestAfter.updatedAt == request.time
        && task.id == taskId
        && task.companyId == companyId
        && task.requestId == workflowRequestId
        && task.assigneeUid is string
        && requestAfter.currentAssigneeIds.hasAny([task.assigneeUid])
        && exists(memberPath(companyId, task.assigneeUid))
        && task.stepIndex is int
        && task.stepIndex >= 0
        && task.stepIndex == requestAfter.currentStep
        && task.stepType in ['approval', 'fulfillment']
        && task.stepType == requestAfter.currentStepType
        && task.mode in ['sequential', 'parallel_any']
        && (
          (
            task.stepType == 'approval'
            && task.mode == 'sequential'
          )
          || (
            task.stepType == 'fulfillment'
            && task.mode == 'parallel_any'
          )
        )
        && task.status == 'PENDING'
        && task.decision == ''
        && task.note is string
        && task.note.size() <= 2000
        && task.dueAt is timestamp
        && task.actedAt == null
        && task.createdAt == request.time
        && task.createdBy == request.auth.uid
        && task.updatedAt == request.time
        && task.updatedBy == request.auth.uid
        && task.keys().hasOnly([
          'id',
          'companyId',
          'requestId',
          'stepIndex',
          'stepType',
          'mode',
          'assigneeUid',
          'assigneeRole',
          'status',
