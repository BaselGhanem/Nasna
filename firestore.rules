            && request.resource.data.sourceRequestId.size() <= 80
          )
        )
        && (
          request.resource.data.previousPositionId != request.resource.data.newPositionId
          || request.resource.data.previousManagerEmployeeId != request.resource.data.newManagerEmployeeId
          || request.resource.data.previousEmploymentType != request.resource.data.newEmploymentType
          || request.resource.data.previousEmploymentStatus != request.resource.data.newEmploymentStatus
          || request.resource.data.previousWorkMode != request.resource.data.newWorkMode
        )
        && (
          (
            request.resource.data.movementType in [
              'transfer',
              'promotion',
              'reassignment'
            ]
            && request.resource.data.previousPositionId
              != request.resource.data.newPositionId
          )
          || (
            request.resource.data.movementType == 'manager_change'
            && request.resource.data.previousManagerEmployeeId
              != request.resource.data.newManagerEmployeeId
          )
          || (
            request.resource.data.movementType == 'employment_change'
            && request.resource.data.previousEmploymentType
              != request.resource.data.newEmploymentType
          )
          || (
            request.resource.data.movementType == 'status_change'
            && request.resource.data.previousEmploymentStatus
              != request.resource.data.newEmploymentStatus
          )
          || (
            request.resource.data.movementType == 'work_mode_change'
            && request.resource.data.previousWorkMode
              != request.resource.data.newWorkMode
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string;
    }

    function employeeAssignmentChangeBacked(companyId, employeeId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let assignmentChanged = affected.hasAny([
        'accessStatus',
        'positionId',
        'jobTitleId',
        'branchId',
        'locationId',
        'departmentId',
        'teamId',
        'managerEmployeeId',
        'employmentType',
        'employmentStatus',
        'workMode'
      ]);
      let movementLinked = affected.hasAny(['lastMovementId']);
      return (
          !assignmentChanged
          && !movementLinked
        )
        || (
          assignmentChanged
          && movementLinked
          && !exists(
            employeeMovementPath(companyId, request.resource.data.lastMovementId)
          )
          && existsAfter(employeeMovementPath(companyId, request.resource.data.lastMovementId))
          && getAfter(
            employeeMovementPath(companyId, request.resource.data.lastMovementId)
          ).data.employeeId == employeeId
          && getAfter(
            employeeMovementPath(companyId, request.resource.data.lastMovementId)
          ).data.employeeAuthUid == request.resource.data.authUid
        );
    }

    function validEmployeePrivateShape(companyId, employeeId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'authUid',
          'nationalId',
          'dateOfBirth',
          'gender',
          'maritalStatus',
          'nationality',
          'personalEmail',
          'personalPhone',
          'address',
          'emergencyContactName',
          'emergencyContactPhone',
          'hrNotes',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'authUid',
          'nationalId',
          'dateOfBirth',
          'gender',
          'maritalStatus',
          'nationality',
          'personalEmail',
          'personalPhone',
          'address',
          'emergencyContactName',
          'emergencyContactPhone',
          'hrNotes',
          'lastRequestId',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == employeeId
        && request.resource.data.companyId == companyId
        && request.resource.data.authUid is string
        && request.resource.data.authUid.size() > 0
        && request.resource.data.nationalId is string
        && request.resource.data.nationalId.size() <= 40
        && (
          request.resource.data.dateOfBirth == null
          || request.resource.data.dateOfBirth is timestamp
        )
        && request.resource.data.gender in ['not_disclosed', 'male', 'female']
        && request.resource.data.maritalStatus in [
          'not_disclosed',
          'single',
          'married',
          'divorced',
          'widowed'
        ]
        && request.resource.data.nationality is string
        && request.resource.data.nationality.size() <= 80
        && request.resource.data.personalEmail is string
        && request.resource.data.personalEmail.size() <= 160
        && (
          request.resource.data.personalEmail == ''
          || request.resource.data.personalEmail.matches('^.+@.+\\..+$')
        )
        && request.resource.data.personalPhone is string
        && request.resource.data.personalPhone.size() <= 30
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 240
        && request.resource.data.emergencyContactName is string
        && request.resource.data.emergencyContactName.size() <= 120
        && request.resource.data.emergencyContactPhone is string
        && request.resource.data.emergencyContactPhone.size() <= 30
        && request.resource.data.hrNotes is string
        && request.resource.data.hrNotes.size() <= 2000
        && (
          !request.resource.data.keys().hasAny(['lastRequestId'])
          || (
            request.resource.data.lastRequestId is string
            && request.resource.data.lastRequestId.size() > 0
            && request.resource.data.lastRequestId.size() <= 80
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
