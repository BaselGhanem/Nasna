rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(companyId, uid) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/members/$(uid);
    }

    function companyPath(companyId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId);
    }

    function branchPath(companyId, branchId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/branches/$(branchId);
    }

    function locationPath(companyId, locationId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/locations/$(locationId);
    }

    function departmentPath(companyId, departmentId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/departments/$(departmentId);
    }

    function teamPath(companyId, teamId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/teams/$(teamId);
    }

    function jobGradePath(companyId, gradeId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/jobGrades/$(gradeId);
    }

    function jobTitlePath(companyId, jobTitleId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/jobTitles/$(jobTitleId);
    }

    function positionPath(companyId, positionId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/positions/$(positionId);
    }

    function employeePath(companyId, employeeId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/employees/$(employeeId);
    }

    function employeeMovementPath(companyId, movementId) {
      return /databases/$(database)/documents/nasna_companies/$(companyId)/employeeMovements/$(movementId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/nasna_users/$(uid);
    }

    function member(companyId) {
      return get(memberPath(companyId, request.auth.uid));
    }

    function memberAfter(companyId, uid) {
      return getAfter(memberPath(companyId, uid));
    }

    function activeMember(companyId) {
      return signedIn()
        && exists(memberPath(companyId, request.auth.uid))
        && member(companyId).data.status == 'active';
    }

    function activeMemberAfter(companyId) {
      return signedIn()
        && memberAfter(companyId, request.auth.uid).data.status == 'active';
    }

    function roleIn(companyId, roles) {
      return activeMember(companyId)
        && member(companyId).data.role in roles;
    }

    function admin(companyId) {
      return roleIn(companyId, ['super_admin', 'hr_admin']);
    }

    function superAdmin(companyId) {
      return roleIn(companyId, ['super_admin']);
    }

    function validUserShape(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.activeCompanyId is string
        && request.resource.data.status in ['active', 'disabled'];
    }

    function validStructureCode(value) {
      return value is string
        && value.matches('^[A-Z0-9][A-Z0-9-]{1,19}$');
    }

    function validStructureName(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 100;
    }

    function validBranchShape(companyId, branchId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == branchId
        && request.resource.data.companyId == companyId
        && request.resource.data.code == branchId
        && validStructureCode(request.resource.data.code)
        && validStructureName(request.resource.data.nameEn)
        && validStructureName(request.resource.data.nameAr)
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validLocationShape(companyId, locationId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'branchId',
          'nameEn',
          'nameAr',
          'city',
          'address',
          'timezone',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'branchId',
          'nameEn',
          'nameAr',
          'city',
          'address',
          'timezone',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == locationId
        && request.resource.data.companyId == companyId
        && request.resource.data.code == locationId
        && validStructureCode(request.resource.data.code)
        && validStructureCode(request.resource.data.branchId)
        && validStructureName(request.resource.data.nameEn)
        && validStructureName(request.resource.data.nameAr)
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 80
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 200
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() > 0
        && request.resource.data.timezone.size() <= 80
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validDepartmentShape(companyId, departmentId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'branchId',
          'nameEn',
          'nameAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'branchId',
          'nameEn',
          'nameAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == departmentId
        && request.resource.data.companyId == companyId
        && request.resource.data.code == departmentId
        && validStructureCode(request.resource.data.code)
        && validStructureCode(request.resource.data.branchId)
        && validStructureName(request.resource.data.nameEn)
        && validStructureName(request.resource.data.nameAr)
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validTeamShape(companyId, teamId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'departmentId',
          'nameEn',
          'nameAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'departmentId',
          'nameEn',
          'nameAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == teamId
        && request.resource.data.companyId == companyId
        && request.resource.data.code == teamId
        && validStructureCode(request.resource.data.code)
        && validStructureCode(request.resource.data.departmentId)
        && validStructureName(request.resource.data.nameEn)
        && validStructureName(request.resource.data.nameAr)
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validJobGradeShape(companyId, gradeId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'level',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'nameEn',
          'nameAr',
          'level',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == gradeId
        && request.resource.data.companyId == companyId
        && request.resource.data.code == gradeId
        && validStructureCode(request.resource.data.code)
        && validStructureName(request.resource.data.nameEn)
        && validStructureName(request.resource.data.nameAr)
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 100
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validJobTitleShape(companyId, jobTitleId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'gradeId',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'gradeId',
          'nameEn',
          'nameAr',
          'descriptionEn',
          'descriptionAr',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == jobTitleId
        && request.resource.data.companyId == companyId
        && request.resource.data.code == jobTitleId
        && validStructureCode(request.resource.data.code)
        && validStructureCode(request.resource.data.gradeId)
        && validStructureName(request.resource.data.nameEn)
        && validStructureName(request.resource.data.nameAr)
        && request.resource.data.descriptionEn is string
        && request.resource.data.descriptionEn.size() <= 4000
        && request.resource.data.descriptionAr is string
        && request.resource.data.descriptionAr.size() <= 4000
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validPositionShape(companyId, positionId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'code',
          'jobTitleId',
          'branchId',
          'locationId',
          'departmentId',
          'teamId',
          'headcount',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'code',
          'jobTitleId',
          'branchId',
          'locationId',
          'departmentId',
          'teamId',
          'headcount',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == positionId
        && request.resource.data.companyId == companyId
        && request.resource.data.code == positionId
        && validStructureCode(request.resource.data.code)
        && validStructureCode(request.resource.data.jobTitleId)
        && validStructureCode(request.resource.data.branchId)
        && (
          request.resource.data.locationId == ''
          || validStructureCode(request.resource.data.locationId)
        )
        && validStructureCode(request.resource.data.departmentId)
        && (
          request.resource.data.teamId == ''
          || validStructureCode(request.resource.data.teamId)
        )
        && request.resource.data.headcount is int
        && request.resource.data.headcount >= 1
        && request.resource.data.headcount <= 10000
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function activeEmploymentStatus(status) {
      return status in ['active', 'probation', 'leave'];
    }

    function validEmployeeShape(companyId, employeeId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'employeeCode',
          'authUid',
          'accessStatus',
          'fullNameEn',
          'fullNameAr',
          'workEmail',
          'workPhone',
          'positionId',
          'jobTitleId',
          'branchId',
          'locationId',
          'departmentId',
          'teamId',
          'managerEmployeeId',
          'hireDate',
          'employmentType',
          'employmentStatus',
          'workMode',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'employeeCode',
          'authUid',
          'accessStatus',
          'fullNameEn',
          'fullNameAr',
          'workEmail',
          'workPhone',
          'positionId',
          'jobTitleId',
          'branchId',
          'locationId',
          'departmentId',
          'teamId',
          'managerEmployeeId',
          'hireDate',
          'employmentType',
          'employmentStatus',
          'workMode',
          'lastMovementId',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == employeeId
        && request.resource.data.companyId == companyId
        && request.resource.data.employeeCode == employeeId
        && validStructureCode(request.resource.data.employeeCode)
        && request.resource.data.authUid is string
        && request.resource.data.authUid.size() > 0
        && request.resource.data.authUid.size() <= 128
        && request.resource.data.accessStatus in ['active', 'disabled']
        && validStructureName(request.resource.data.fullNameEn)
        && validStructureName(request.resource.data.fullNameAr)
        && request.resource.data.workEmail is string
        && request.resource.data.workEmail.size() > 3
        && request.resource.data.workEmail.size() <= 160
        && request.resource.data.workEmail.matches('^.+@.+\\..+$')
        && request.resource.data.workPhone is string
        && request.resource.data.workPhone.size() <= 30
        && validStructureCode(request.resource.data.positionId)
        && validStructureCode(request.resource.data.jobTitleId)
        && validStructureCode(request.resource.data.branchId)
        && (
          request.resource.data.locationId == ''
          || validStructureCode(request.resource.data.locationId)
        )
        && validStructureCode(request.resource.data.departmentId)
        && (
          request.resource.data.teamId == ''
          || validStructureCode(request.resource.data.teamId)
        )
        && (
          request.resource.data.managerEmployeeId == ''
          || validStructureCode(request.resource.data.managerEmployeeId)
        )
        && request.resource.data.managerEmployeeId != employeeId
        && request.resource.data.hireDate is timestamp
        && request.resource.data.employmentType in [
          'permanent',
          'fixed_term',
          'part_time',
          'intern',
          'consultant'
        ]
        && request.resource.data.employmentStatus in [
          'active',
          'probation',
          'leave',
          'suspended'
        ]
        && request.resource.data.workMode in ['onsite', 'hybrid', 'remote']
        && (
          !request.resource.data.keys().hasAny(['lastMovementId'])
          || (
            request.resource.data.lastMovementId is string
            && request.resource.data.lastMovementId.size() > 0
            && request.resource.data.lastMovementId.size() <= 80
          )
        )
        && (
          (
            request.resource.data.employmentStatus == 'suspended'
            && request.resource.data.accessStatus == 'disabled'
          )
          || (
            activeEmploymentStatus(request.resource.data.employmentStatus)
            && request.resource.data.accessStatus == 'active'
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validEmployeeUpdateValues(employeeId) {
      return request.resource.data.accessStatus in ['active', 'disabled']
        && validStructureName(request.resource.data.fullNameEn)
        && validStructureName(request.resource.data.fullNameAr)
        && request.resource.data.workPhone is string
        && request.resource.data.workPhone.size() <= 30
        && validStructureCode(request.resource.data.positionId)
        && validStructureCode(request.resource.data.jobTitleId)
        && validStructureCode(request.resource.data.branchId)
        && (
          request.resource.data.locationId == ''
          || validStructureCode(request.resource.data.locationId)
        )
        && validStructureCode(request.resource.data.departmentId)
        && (
          request.resource.data.teamId == ''
          || validStructureCode(request.resource.data.teamId)
        )
        && (
          request.resource.data.managerEmployeeId == ''
          || validStructureCode(request.resource.data.managerEmployeeId)
        )
        && request.resource.data.managerEmployeeId != employeeId
        && request.resource.data.hireDate is timestamp
        && request.resource.data.employmentType in [
          'permanent',
          'fixed_term',
          'part_time',
          'intern',
          'consultant'
        ]
        && request.resource.data.employmentStatus in [
          'active',
          'probation',
          'leave',
          'suspended'
        ]
        && request.resource.data.workMode in ['onsite', 'hybrid', 'remote']
        && (
          !request.resource.data.keys().hasAny(['lastMovementId'])
          || (
            request.resource.data.lastMovementId is string
            && request.resource.data.lastMovementId.size() > 0
            && request.resource.data.lastMovementId.size() <= 80
          )
        )
        && (
          (
            request.resource.data.employmentStatus == 'suspended'
            && request.resource.data.accessStatus == 'disabled'
          )
          || (
            activeEmploymentStatus(request.resource.data.employmentStatus)
            && request.resource.data.accessStatus == 'active'
          )
        );
    }

    function validEmployeeDocumentShape(companyId, documentId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'employeeId',
          'employeeAuthUid',
          'type',
          'title',
          'documentNumber',
          'issueDate',
          'expiryDate',
          'linkUrl',
          'visibility',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'employeeId',
          'employeeAuthUid',
          'type',
          'title',
          'documentNumber',
          'issueDate',
          'expiryDate',
          'linkUrl',
          'visibility',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == documentId
        && request.resource.data.companyId == companyId
        && request.resource.data.employeeId is string
        && validStructureCode(request.resource.data.employeeId)
        && request.resource.data.employeeAuthUid is string
        && request.resource.data.employeeAuthUid.size() > 0
        && request.resource.data.employeeAuthUid.size() <= 128
        && request.resource.data.type in [
          'contract',
          'national_id',
          'passport',
          'work_permit',
          'insurance',
          'certificate',
          'other'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.documentNumber is string
        && request.resource.data.documentNumber.size() <= 80
        && (
          request.resource.data.issueDate == null
          || request.resource.data.issueDate is timestamp
        )
        && (
          request.resource.data.expiryDate == null
          || request.resource.data.expiryDate is timestamp
        )
        && (
          request.resource.data.issueDate == null
          || request.resource.data.expiryDate == null
          || request.resource.data.expiryDate >= request.resource.data.issueDate
        )
        && request.resource.data.linkUrl is string
        && request.resource.data.linkUrl.size() <= 500
        && (
          request.resource.data.linkUrl == ''
          || request.resource.data.linkUrl.matches('^https://.+$')
        )
        && request.resource.data.visibility in ['employee', 'hr_only']
        && request.resource.data.status in ['active', 'revoked']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function validEmployeeMovementShape(companyId, movementId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'employeeId',
          'employeeAuthUid',
          'movementType',
          'effectiveDate',
          'reason',
          'previousPositionId',
          'newPositionId',
          'previousManagerEmployeeId',
          'newManagerEmployeeId',
          'previousEmploymentType',
          'newEmploymentType',
          'previousEmploymentStatus',
          'newEmploymentStatus',
          'previousWorkMode',
          'newWorkMode',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'employeeId',
          'employeeAuthUid',
          'movementType',
          'effectiveDate',
          'reason',
          'previousPositionId',
          'newPositionId',
          'previousManagerEmployeeId',
          'newManagerEmployeeId',
          'previousEmploymentType',
          'newEmploymentType',
          'previousEmploymentStatus',
          'newEmploymentStatus',
          'previousWorkMode',
          'newWorkMode',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.id == movementId
        && request.resource.data.companyId == companyId
        && validStructureCode(request.resource.data.employeeId)
        && request.resource.data.employeeAuthUid is string
        && request.resource.data.employeeAuthUid.size() > 0
        && request.resource.data.employeeAuthUid.size() <= 128
        && request.resource.data.movementType in [
          'transfer',
          'promotion',
          'reassignment',
          'manager_change',
          'employment_change',
          'status_change',
          'work_mode_change'
        ]
        && request.resource.data.effectiveDate is timestamp
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && validStructureCode(request.resource.data.previousPositionId)
        && validStructureCode(request.resource.data.newPositionId)
        && (
          request.resource.data.previousManagerEmployeeId == ''
          || validStructureCode(request.resource.data.previousManagerEmployeeId)
        )
        && (
          request.resource.data.newManagerEmployeeId == ''
          || validStructureCode(request.resource.data.newManagerEmployeeId)
        )
        && request.resource.data.previousEmploymentType in [
          'permanent',
          'fixed_term',
          'part_time',
          'intern',
          'consultant'
        ]
        && request.resource.data.newEmploymentType in [
          'permanent',
          'fixed_term',
          'part_time',
          'intern',
          'consultant'
        ]
        && request.resource.data.previousEmploymentStatus in [
          'active',
          'probation',
          'leave',
          'suspended'
        ]
        && request.resource.data.newEmploymentStatus in [
          'active',
          'probation',
          'leave',
          'suspended'
        ]
        && request.resource.data.previousWorkMode in ['onsite', 'hybrid', 'remote']
        && request.resource.data.newWorkMode in ['onsite', 'hybrid', 'remote']
        && (
          request.resource.data.previousPositionId != request.resource.data.newPositionId
          || request.resource.data.previousManagerEmployeeId != request.resource.data.newManagerEmployeeId
          || request.resource.data.previousEmploymentType != request.resource.data.newEmploymentType
          || request.resource.data.previousEmploymentStatus != request.resource.data.newEmploymentStatus
          || request.resource.data.previousWorkMode != request.resource.data.newWorkMode
        )
        && (
          (
            request.resource.data.movementType in [
              'transfer',
              'promotion',
              'reassignment'
            ]
            && request.resource.data.previousPositionId
              != request.resource.data.newPositionId
          )
          || (
            request.resource.data.movementType == 'manager_change'
            && request.resource.data.previousManagerEmployeeId
              != request.resource.data.newManagerEmployeeId
          )
          || (
            request.resource.data.movementType == 'employment_change'
            && request.resource.data.previousEmploymentType
              != request.resource.data.newEmploymentType
          )
          || (
            request.resource.data.movementType == 'status_change'
            && request.resource.data.previousEmploymentStatus
              != request.resource.data.newEmploymentStatus
          )
          || (
            request.resource.data.movementType == 'work_mode_change'
            && request.resource.data.previousWorkMode
              != request.resource.data.newWorkMode
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string;
    }

    function employeeAssignmentChangeBacked(companyId, employeeId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let assignmentChanged = affected.hasAny([
        'accessStatus',
        'positionId',
        'jobTitleId',
        'branchId',
        'locationId',
        'departmentId',
        'teamId',
        'managerEmployeeId',
        'employmentType',
        'employmentStatus',
        'workMode'
      ]);
      let movementLinked = affected.hasAny(['lastMovementId']);
      return (
          !assignmentChanged
          && !movementLinked
        )
        || (
          assignmentChanged
          && movementLinked
          && !exists(
            employeeMovementPath(companyId, request.resource.data.lastMovementId)
          )
          && existsAfter(employeeMovementPath(companyId, request.resource.data.lastMovementId))
          && getAfter(
            employeeMovementPath(companyId, request.resource.data.lastMovementId)
          ).data.employeeId == employeeId
          && getAfter(
            employeeMovementPath(companyId, request.resource.data.lastMovementId)
          ).data.employeeAuthUid == request.resource.data.authUid
        );
    }

    function validEmployeePrivateShape(companyId, employeeId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'authUid',
          'nationalId',
          'dateOfBirth',
          'gender',
          'maritalStatus',
          'nationality',
          'personalEmail',
          'personalPhone',
          'address',
          'emergencyContactName',
          'emergencyContactPhone',
          'hrNotes',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'companyId',
          'authUid',
          'nationalId',
          'dateOfBirth',
          'gender',
          'maritalStatus',
          'nationality',
          'personalEmail',
          'personalPhone',
          'address',
          'emergencyContactName',
          'emergencyContactPhone',
          'hrNotes',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == employeeId
        && request.resource.data.companyId == companyId
        && request.resource.data.authUid is string
        && request.resource.data.authUid.size() > 0
        && request.resource.data.nationalId is string
        && request.resource.data.nationalId.size() <= 40
        && (
          request.resource.data.dateOfBirth == null
          || request.resource.data.dateOfBirth is timestamp
        )
        && request.resource.data.gender in ['not_disclosed', 'male', 'female']
        && request.resource.data.maritalStatus in [
          'not_disclosed',
          'single',
          'married',
          'divorced',
          'widowed'
        ]
        && request.resource.data.nationality is string
        && request.resource.data.nationality.size() <= 80
        && request.resource.data.personalEmail is string
        && request.resource.data.personalEmail.size() <= 160
        && (
          request.resource.data.personalEmail == ''
          || request.resource.data.personalEmail.matches('^.+@.+\\..+$')
        )
        && request.resource.data.personalPhone is string
        && request.resource.data.personalPhone.size() <= 30
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 240
        && request.resource.data.emergencyContactName is string
        && request.resource.data.emergencyContactName.size() <= 120
        && request.resource.data.emergencyContactPhone is string
        && request.resource.data.emergencyContactPhone.size() <= 30
        && request.resource.data.hrNotes is string
        && request.resource.data.hrNotes.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function activePositionRelations(companyId) {
      let position = request.resource.data;
      return position.status == 'inactive'
        || (
          get(branchPath(companyId, position.branchId)).data.status == 'active'
          && get(departmentPath(companyId, position.departmentId)).data.status == 'active'
          && get(departmentPath(companyId, position.departmentId)).data.branchId == position.branchId
          && get(jobTitlePath(companyId, position.jobTitleId)).data.status == 'active'
          && get(jobGradePath(
            companyId,
            get(jobTitlePath(companyId, position.jobTitleId)).data.gradeId
          )).data.status == 'active'
          && (
            position.locationId == ''
            || (
              get(locationPath(companyId, position.locationId)).data.status == 'active'
              && get(locationPath(companyId, position.locationId)).data.branchId == position.branchId
            )
          )
          && (
            position.teamId == ''
            || (
              get(teamPath(companyId, position.teamId)).data.status == 'active'
              && get(teamPath(companyId, position.teamId)).data.departmentId == position.departmentId
            )
          )
        );
    }

    function activeEmployeeRelations(companyId, employeeId) {
      let employee = request.resource.data;
      let position = get(positionPath(companyId, employee.positionId)).data;
      return exists(positionPath(companyId, employee.positionId))
        && employee.jobTitleId == position.jobTitleId
        && employee.branchId == position.branchId
        && employee.locationId == position.locationId
        && employee.departmentId == position.departmentId
        && employee.teamId == position.teamId
        && (
          employee.employmentStatus == 'suspended'
          || (
            position.status == 'active'
            && (
            employee.managerEmployeeId == ''
            || (
              exists(employeePath(companyId, employee.managerEmployeeId))
              && activeEmploymentStatus(
                get(employeePath(companyId, employee.managerEmployeeId)).data.employmentStatus
              )
            )
            )
          )
        );
    }

    match /nasna_users/{uid} {
      allow get: if signedIn()
        && (
          request.auth.uid == uid
          || (
            resource.data.activeCompanyId is string
            && admin(resource.data.activeCompanyId)
          )
        );

      allow list: if false;

      allow create: if signedIn()
        && validUserShape(uid)
        && (
          (
            request.auth.uid == uid
            && request.resource.data.email == request.auth.token.email
            && activeMemberAfter(request.resource.data.activeCompanyId)
          )
          || admin(request.resource.data.activeCompanyId)
        );

      allow update: if signedIn()
        && validUserShape(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (
          (
            request.auth.uid == uid
            && request.resource.data.status == resource.data.status
            && activeMemberAfter(request.resource.data.activeCompanyId)
          )
          || admin(resource.data.activeCompanyId)
        );

      allow delete: if false;
    }

    match /nasna_companies/{companyId} {
      allow get: if activeMember(companyId);
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && memberAfter(companyId, request.auth.uid).data.role == 'super_admin'
        && memberAfter(companyId, request.auth.uid).data.status == 'active';

      allow update: if superAdmin(companyId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in ['active', 'suspended'];

      allow delete: if false;

      match /members/{memberId} {
        allow read: if activeMember(companyId);

        allow create: if signedIn()
          && request.resource.data.uid == memberId
          && request.resource.data.companyId == companyId
          && request.resource.data.role in ['super_admin', 'hr_admin', 'manager', 'employee']
          && request.resource.data.status in ['active', 'disabled']
          && (
            (
              request.auth.uid == memberId
              && getAfter(companyPath(companyId)).data.ownerId == request.auth.uid
              && request.resource.data.role == 'super_admin'
              && request.resource.data.status == 'active'
            )
            || (
              admin(companyId)
              && (
                request.resource.data.role != 'super_admin'
                || superAdmin(companyId)
              )
            )
          );

        allow update: if admin(companyId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.email == resource.data.email
          && request.resource.data.role in ['super_admin', 'hr_admin', 'manager', 'employee']
          && request.resource.data.status in ['active', 'disabled']
          && (
            superAdmin(companyId)
            || (
              resource.data.role != 'super_admin'
              && request.resource.data.role != 'super_admin'
            )
          )
          && (
            memberId != get(companyPath(companyId)).data.ownerId
            || (
              request.resource.data.role == 'super_admin'
              && request.resource.data.status == 'active'
            )
          );

        allow delete: if superAdmin(companyId)
          && memberId != get(companyPath(companyId)).data.ownerId;
      }

      match /branches/{branchId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validBranchShape(companyId, branchId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validBranchShape(companyId, branchId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nameEn',
            'nameAr',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /locations/{locationId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validLocationShape(companyId, locationId)
          && exists(branchPath(companyId, request.resource.data.branchId))
          && get(branchPath(companyId, request.resource.data.branchId)).data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validLocationShape(companyId, locationId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && (
            request.resource.data.status == 'inactive'
            || (
              exists(branchPath(companyId, request.resource.data.branchId))
              && get(branchPath(companyId, request.resource.data.branchId)).data.status == 'active'
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'branchId',
            'nameEn',
            'nameAr',
            'city',
            'address',
            'timezone',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /departments/{departmentId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validDepartmentShape(companyId, departmentId)
          && exists(branchPath(companyId, request.resource.data.branchId))
          && get(branchPath(companyId, request.resource.data.branchId)).data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validDepartmentShape(companyId, departmentId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && (
            request.resource.data.status == 'inactive'
            || (
              exists(branchPath(companyId, request.resource.data.branchId))
              && get(branchPath(companyId, request.resource.data.branchId)).data.status == 'active'
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'branchId',
            'nameEn',
            'nameAr',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /teams/{teamId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validTeamShape(companyId, teamId)
          && exists(departmentPath(companyId, request.resource.data.departmentId))
          && get(departmentPath(companyId, request.resource.data.departmentId)).data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validTeamShape(companyId, teamId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && (
            request.resource.data.status == 'inactive'
            || (
              exists(departmentPath(companyId, request.resource.data.departmentId))
              && get(departmentPath(companyId, request.resource.data.departmentId)).data.status == 'active'
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'departmentId',
            'nameEn',
            'nameAr',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /jobGrades/{gradeId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validJobGradeShape(companyId, gradeId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validJobGradeShape(companyId, gradeId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nameEn',
            'nameAr',
            'level',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /jobTitles/{jobTitleId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validJobTitleShape(companyId, jobTitleId)
          && exists(jobGradePath(companyId, request.resource.data.gradeId))
          && get(jobGradePath(companyId, request.resource.data.gradeId)).data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validJobTitleShape(companyId, jobTitleId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && (
            request.resource.data.status == 'inactive'
            || (
              exists(jobGradePath(companyId, request.resource.data.gradeId))
              && get(jobGradePath(companyId, request.resource.data.gradeId)).data.status == 'active'
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'gradeId',
            'nameEn',
            'nameAr',
            'descriptionEn',
            'descriptionAr',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /positions/{positionId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validPositionShape(companyId, positionId)
          && activePositionRelations(companyId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validPositionShape(companyId, positionId)
          && activePositionRelations(companyId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'jobTitleId',
            'branchId',
            'locationId',
            'departmentId',
            'teamId',
            'headcount',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /employees/{employeeId} {
        allow read: if activeMember(companyId);

        allow create: if admin(companyId)
          && validEmployeeShape(companyId, employeeId)
          && activeEmployeeRelations(companyId, employeeId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && memberAfter(companyId, request.resource.data.authUid).data.employeeId == employeeId
          && memberAfter(companyId, request.resource.data.authUid).data.email == request.resource.data.workEmail
          && memberAfter(companyId, request.resource.data.authUid).data.status == request.resource.data.accessStatus
          && getAfter(userPath(request.resource.data.authUid)).data.employeeId == employeeId
          && getAfter(userPath(request.resource.data.authUid)).data.activeCompanyId == companyId
          && getAfter(userPath(request.resource.data.authUid)).data.email == request.resource.data.workEmail
          && getAfter(userPath(request.resource.data.authUid)).data.status == request.resource.data.accessStatus;

        allow update: if admin(companyId)
          && validEmployeeUpdateValues(employeeId)
          && activeEmployeeRelations(companyId, employeeId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.employeeCode == resource.data.employeeCode
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.workEmail == resource.data.workEmail
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && employeeAssignmentChangeBacked(companyId, employeeId)
          && memberAfter(companyId, request.resource.data.authUid).data.employeeId == employeeId
          && memberAfter(companyId, request.resource.data.authUid).data.status == request.resource.data.accessStatus
          && getAfter(userPath(request.resource.data.authUid)).data.employeeId == employeeId
          && getAfter(userPath(request.resource.data.authUid)).data.status == request.resource.data.accessStatus
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accessStatus',
            'fullNameEn',
            'fullNameAr',
            'workPhone',
            'positionId',
            'jobTitleId',
            'branchId',
            'locationId',
            'departmentId',
            'teamId',
            'managerEmployeeId',
            'hireDate',
            'employmentType',
            'employmentStatus',
            'workMode',
            'lastMovementId',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /employeePrivate/{employeeId} {
        allow get: if admin(companyId)
          || (
            activeMember(companyId)
            && resource.data.authUid == request.auth.uid
          );

        allow list: if admin(companyId);

        allow create: if admin(companyId)
          && validEmployeePrivateShape(companyId, employeeId)
          && getAfter(employeePath(companyId, employeeId)).data.authUid == request.resource.data.authUid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validEmployeePrivateShape(companyId, employeeId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nationalId',
            'dateOfBirth',
            'gender',
            'maritalStatus',
            'nationality',
            'personalEmail',
            'personalPhone',
            'address',
            'emergencyContactName',
            'emergencyContactPhone',
            'hrNotes',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /employeeDocuments/{documentId} {
        allow read: if admin(companyId)
          || (
            activeMember(companyId)
            && resource.data.employeeAuthUid == request.auth.uid
            && resource.data.visibility == 'employee'
          );

        allow create: if admin(companyId)
          && validEmployeeDocumentShape(companyId, documentId)
          && exists(employeePath(companyId, request.resource.data.employeeId))
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.authUid == request.resource.data.employeeAuthUid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if admin(companyId)
          && validEmployeeDocumentShape(companyId, documentId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.employeeAuthUid == resource.data.employeeAuthUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type',
            'title',
            'documentNumber',
            'issueDate',
            'expiryDate',
            'linkUrl',
            'visibility',
            'status',
            'updatedAt',
            'updatedBy'
          ]);

        allow delete: if false;
      }

      match /employeeMovements/{movementId} {
        allow read: if admin(companyId)
          || (
            activeMember(companyId)
            && resource.data.employeeAuthUid == request.auth.uid
          );

        allow create: if admin(companyId)
          && validEmployeeMovementShape(companyId, movementId)
          && request.resource.data.effectiveDate <= request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && exists(employeePath(companyId, request.resource.data.employeeId))
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.authUid == request.resource.data.employeeAuthUid
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.positionId == request.resource.data.previousPositionId
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.managerEmployeeId == request.resource.data.previousManagerEmployeeId
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.employmentType == request.resource.data.previousEmploymentType
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.employmentStatus == request.resource.data.previousEmploymentStatus
          && get(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.workMode == request.resource.data.previousWorkMode
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.lastMovementId == movementId
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.positionId == request.resource.data.newPositionId
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.managerEmployeeId == request.resource.data.newManagerEmployeeId
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.employmentType == request.resource.data.newEmploymentType
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.employmentStatus == request.resource.data.newEmploymentStatus
          && getAfter(
            employeePath(companyId, request.resource.data.employeeId)
          ).data.workMode == request.resource.data.newWorkMode;

        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if admin(companyId);

        allow create: if signedIn()
          && activeMemberAfter(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorEmail is string
          && request.resource.data.action is string
          && request.resource.data.action.size() > 0
          && request.resource.data.action.size() <= 100
          && request.resource.data.targetId is string
          && request.resource.data.details is map
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly([
            'companyId',
            'actorId',
            'actorEmail',
            'action',
            'targetId',
            'details',
            'createdAt'
          ]);

        allow update, delete: if false;
      }
    }
  }
}
