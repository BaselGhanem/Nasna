                  && request.resource.data.draftToken
                    == resource.data.draftToken
                  && request.resource.data.revision
                    == resource.data.revision
                  && request.resource.data.assignmentCount
                    == resource.data.assignmentCount
                  && request.resource.data.timezone
                    == resource.data.timezone
                  && request.resource.data.policyId
                    == resource.data.policyId
                  && request.resource.data.publishTotal
                    == resource.data.publishTotal
                  && request.resource.data.publishCompleted
                    == resource.data.publishCompleted
                  && request.resource.data.publishToken
                    == resource.data.publishToken
                  && request.resource.data.publishConflictResult
                    == resource.data.publishConflictResult
                  && request.resource.data.publishOverrideReason
                    == resource.data.publishOverrideReason
                  && request.resource.data.lastPublishedAssignmentId
                    == resource.data.lastPublishedAssignmentId
                  && request.resource.data.diff(resource.data)
